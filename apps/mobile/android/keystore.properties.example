# ADR-256: copy to keystore.properties (same folder, never committed) and fill
# in. docs/release/signing-guide.md explains every line.
# storeFile is relative to android/app/ or absolute; keep the .jks outside the repo.
storeFile=/Users/you/palee-signing/palee-upload.jks
storePassword=CHANGE_ME
keyAlias=palee-upload
keyPassword=CHANGE_ME
