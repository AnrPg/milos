{
  "name": "palee-mobile",
  "version": "3.0.0",
  "private": true,
  "description": "Palee store apps (iOS and Android): a Capacitor shell around the deployed web app (ADR-171).",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "sync": "node scripts/configure.mjs && cap sync",
    "sync:android": "node scripts/configure.mjs && cap sync android",
    "sync:ios": "node scripts/configure.mjs && cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "bootstrap": "sh scripts/bootstrap.sh",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
