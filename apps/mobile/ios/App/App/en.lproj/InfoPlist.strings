/* ADR-256: the reasons iOS shows when Palee asks for a permission (English). Keep in step with Info.plist and el.lproj. */
"CFBundleDisplayName" = "Palee";
"NSCameraUsageDescription" = "Palee uses the camera when you scan your box's check-in QR code, take a body photo or add a photo to a post. A photo is saved only when you choose to.";
"NSPhotoLibraryUsageDescription" = "Palee opens your photos only when you pick one for your profile, a post or a body photo.";
"NSMicrophoneUsageDescription" = "Palee uses the microphone only while you record a workout by voice. The recording is not kept.";
"NSHealthShareUsageDescription" = "Palee reads the workouts, sleep, weight, resting heart rate and steps you choose, so they appear in your journal. Only you see them unless you share them.";
"NSLocationWhenInUseUsageDescription" = "Palee uses your location to show boxes near you (rounded and never saved) and, on this phone only, to remind you to check in when you arrive at your box with a booking. You can always pick an area instead.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "With \"Always\", Palee can remind you to check in when you arrive at your box with a booking, even while the app is closed. Your location stays on this phone.";
"NFCReaderUsageDescription" = "Palee writes your box's check-in link to an NFC tag at the door.";
