<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ADR-172: read-only HealthKit access (PaleeHealth). -->
    <key>com.apple.developer.healthkit</key>
    <true/>
    <key>com.apple.developer.healthkit.access</key>
    <array/>
    <!-- ADR-173: the App Group shared with the widget extension, and writing NFC tags. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.app.milos.member</string>
    </array>
    <key>com.apple.developer.nfc.readersession.formats</key>
    <array>
        <string>TAG</string>
    </array>
    <!-- palee:app-links begin -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:milos.4kq.net</string>
    </array>
    <key>aps-environment</key>
    <string>production</string>
    <!-- palee:app-links end -->
</dict>
</plist>
