msgstr ""
"Language: nl\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "You're receiving this email because you have a %{product} account."
msgstr "U ontvangt deze e-mail omdat u een %{product}-account hebt."

msgid "You're receiving this email because %{business} sent it to you through %{product}."
msgstr "U ontvangt deze e-mail omdat %{business} hem via %{product} naar u heeft gestuurd."

msgid "This email was sent automatically by %{product}."
msgstr "Deze e-mail is automatisch verstuurd door %{product}."

msgid "If the button doesn't work, copy this link into your browser:"
msgstr "Werkt de knop niet? Kopieer dan deze link naar uw browser:"

msgid "If you didn't ask for this, you can safely ignore this email."
msgstr "Hebt u dit niet aangevraagd, dan kunt u deze e-mail gewoon negeren."

msgid "You're receiving this email because you are the billing contact of %{company} at %{business}."
msgstr "U ontvangt deze e-mail omdat %{business} u heeft opgegeven als contactpersoon voor de facturen van %{company}."

msgid "This link works only once."
msgstr "Deze link werkt maar één keer."

msgid "Hello %{name},"
msgstr "Beste %{name},"

msgid "Hello,"
msgstr "Hallo,"

msgid "Confirm your new email address"
msgstr "Bevestig uw nieuwe e-mailadres"

msgid "Someone asked to make this the sign-in address of a %{product} account. Confirm it to finish the change. Until then, the account keeps its current address."
msgstr "Er is gevraagd om dit adres het aanmeldadres van een %{product}-account te maken. Bevestig het om de wijziging af te ronden. Tot die tijd houdt het account zijn huidige adres."

msgid "Confirm this address"
msgstr "Dit adres bevestigen"

msgid "The link works for 24 hours."
msgstr "De link is 24 uur geldig."

msgid "You're receiving this email because someone asked to use this address for a %{product} account."
msgstr "U ontvangt deze e-mail omdat is gevraagd dit adres te gebruiken voor een %{product}-account."
