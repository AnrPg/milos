msgid "New booking request"
msgstr "Nieuwe boekingsaanvraag"

msgid "Booking approved"
msgstr "Boeking goedgekeurd"

msgid "Booking rejected"
msgstr "Boeking afgewezen"

msgid "Booking timed out"
msgstr "Er is een time-out voor de boeking opgetreden"

msgid "Open the schedule to review the latest booking state."
msgstr "Open het schema om de laatste boekingsstatus te bekijken."

msgid "Workout annotation"
msgstr "Annotatie van de training"

msgid "A workout annotation needs review."
msgstr "Een trainingsannotatie moet worden beoordeeld."

msgid "Workout changed"
msgstr "Training gewijzigd"

msgid "Your coach changed a scheduled workout."
msgstr "Je coach heeft een geplande training gewijzigd."

msgid "Workout removed"
msgstr "Training verwijderd"

msgid "Your coach removed a scheduled workout."
msgstr "Je coach heeft een geplande training verwijderd."

msgid "Workout rejected"
msgstr "Training afgewezen"

msgid "An athlete"
msgstr "Een atleet"

msgid "a workout"
msgstr "een training"

msgid "%{nickname} rejected %{title}."
msgstr "%{nickname} heeft %{title} afgewezen."

msgid "Workout rescheduled"
msgstr "Training opnieuw gepland"

msgid "An athlete rescheduled their workout."
msgstr "Een atleet heeft zijn training opnieuw gepland."

msgid "Message from %{nickname}"
msgstr "Bericht van %{nickname}"

msgid "%{nickname} sent you a message."
msgstr "%{nickname} heeft je een bericht gestuurd."

msgid "New coach note"
msgstr "Nieuwe coachnotitie"

msgid "Your coach added a new note."
msgstr "Je coach heeft een nieuwe notitie toegevoegd."

msgid "Challenge completed"
msgstr "Uitdaging voltooid"

msgid "You completed a challenge."
msgstr "Je hebt een uitdaging voltooid."

msgid "New message in your workout thread"
msgstr "Nieuw bericht in je trainingsthread"

msgid "New message"
msgstr "Nieuw bericht"

msgid "You received a new message."
msgstr "Je hebt een nieuw bericht ontvangen."

msgid "TrainingJournal"
msgstr "Milos-training"

msgid "You have a new notification."
msgstr "U heeft een nieuwe melding."

msgid "invoice"
msgstr "factuur"

msgid "New invoice"
msgstr "Nieuwe factuur"

msgid "Invoice %{invoice_number} has been issued for your account."
msgstr "Factuur %{invoice_number} is uitgegeven voor uw account."

msgid "Payment reminder"
msgstr "Betalingsherinnering"

msgid "You have an outstanding balance of %{amount} due."
msgstr "U heeft een openstaand saldo van %{amount}."

msgid "Workout assignment requested"
msgstr "Workouttoewijzing aangevraagd"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "%{nickname} heeft een workouttoewijzing aangevraagd voor %{requested_for}."

msgid "a requested date"
msgstr "een aangevraagde datum"

msgid "New review submitted"
msgstr "Nieuwe beoordeling ingediend"

msgid "general"
msgstr "algemeen"

msgid "A %{target_type} review was submitted with a %{rating}/5 rating."
msgstr "Er is een beoordeling voor %{target_type} ingediend met een score van %{rating}/5."

msgid "A new %{target_type} review needs attention."
msgstr "Een nieuwe beoordeling voor %{target_type} vereist aandacht."

msgid "Class bookings approved"
msgstr "Lesreserveringen goedgekeurd"

msgid "Your coach approved one or more class booking requests."
msgstr "Uw coach heeft een of meer lesreserveringen goedgekeurd."

msgid "New workouts assigned"
msgstr "Nieuwe trainingen toegewezen"

msgid "Your coach assigned one or more workouts to you."
msgstr "Uw coach heeft een of meer trainingen aan u toegewezen."

msgid "You got a spot"
msgstr "Je hebt een plek"

msgid "A place opened up in %{class}. Your booking is confirmed or awaiting approval."
msgstr "Er is een plek vrijgekomen in %{class}. Je boeking is bevestigd of wacht op goedkeuring."

msgid "Your package ends soon"
msgstr "Je pakket loopt binnenkort af"

msgid "%{package} ends on %{date}."
msgstr "%{package} loopt af op %{date}."

msgid "New form review request"
msgstr "Nieuw verzoek om techniekfeedback"

msgid "%{client} sent a video for feedback."
msgstr "%{client} heeft een video gestuurd voor feedback."

msgid "Your form review is ready"
msgstr "Je techniekfeedback staat klaar"

msgid "Your coach left feedback on your video."
msgstr "Je coach heeft feedback gegeven op je video."

msgid "A client is waiting for a reply"
msgstr "Een klant wacht op een antwoord"

msgid "%{client} has been waiting longer than the promised reply time."
msgstr "%{client} wacht langer dan de beloofde reactietijd."

msgid "Your nutrition plan was updated"
msgstr "Je voedingsplan is bijgewerkt"

msgid "Open it to see what changed."
msgstr "Open het om te zien wat er is veranderd."

msgid "New appointment booked"
msgstr "Nieuwe afspraak geboekt"

msgid "%{client} booked a session for %{time}."
msgstr "%{client} heeft een sessie geboekt voor %{time}."

msgid "Appointment cancelled"
msgstr "Afspraak geannuleerd"

msgid "The session on %{time} was cancelled."
msgstr "De sessie van %{time} is geannuleerd."

msgid "A coach took a new athlete"
msgstr "Een coach heeft een nieuwe atleet aangenomen"

msgid "%{coach} is now coaching %{client}."
msgstr "%{coach} coacht nu %{client}."

msgid "An admin read your note"
msgstr "Een beheerder heeft je notitie gelezen"

msgid "%{reader} read your note about %{client} at %{time}."
msgstr "%{reader} heeft je notitie over %{client} gelezen om %{time}."
