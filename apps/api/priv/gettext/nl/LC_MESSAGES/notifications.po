# ADR-176: a class without its WOD.
msgid "A class has no WOD"
msgstr "Een les heeft geen WOD"

msgid "%{class} (%{when}) has no WOD, so members can't see or book it. Link one to publish it."
msgstr "%{class} (%{when}) heeft geen WOD, dus leden kunnen de les niet zien of boeken. Koppel er een om de les te publiceren."

msgid "%{class} (%{when}) starts in an hour and still has no WOD."
msgstr "%{class} (%{when}) begint over een uur en heeft nog geen WOD."

msgid "%{class} (%{when}) has no WOD yet. Link one before it starts."
msgstr "%{class} (%{when}) heeft nog geen WOD. Koppel er een voordat de les begint."


# ADR-179: a moment on the organiser's clock, then on the reader's when theirs differs.
msgid "%{time} %{zone} · %{local} your time"
msgstr "%{time} %{zone} · %{local} jouw tijd"


# ADR-185: co-hosting an event.
msgid "Co-host request"
msgstr "Verzoek om mede-organisatie"

msgid "%{box} invites you to co-host «%{event}» (%{when})."
msgstr "%{box} nodigt je uit om «%{event}» (%{when}) mee te organiseren."

msgid "Co-hosting"
msgstr "Mede-organisatie"

msgid "%{box} will co-host «%{event}»."
msgstr "%{box} organiseert «%{event}» mee."

msgid "%{box} declined to co-host «%{event}»."
msgstr "%{box} heeft geweigerd «%{event}» mee te organiseren."

msgid "%{box} no longer co-hosts «%{event}»."
msgstr "%{box} organiseert «%{event}» niet meer mee."

# ADR-187: a password reset request (handlers) and the reset itself (the person).
msgid "Password reset request"
msgstr "Verzoek om wachtwoordherstel"

msgid "%{name} (@%{handle}) can't sign in and asked for a password reset."
msgstr "%{name} (@%{handle}) kan niet inloggen en heeft gevraagd om het wachtwoord te herstellen."

msgid "Your password was reset"
msgstr "Je wachtwoord is hersteld"

msgid "Your password was changed with a reset link or a recovery code, and every device was signed out. If this wasn't you, contact your gym or Palee support."
msgstr "Je wachtwoord is gewijzigd met een herstellink of een herstelcode, en je bent op alle apparaten uitgelogd. Was jij dit niet? Neem dan contact op met je sportschool of met Palee-support."
