msgstr ""
"Language: it\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "You're receiving this email because you have a %{product} account."
msgstr "Riceve questa email perché ha un account %{product}."

msgid "You're receiving this email because %{business} sent it to you through %{product}."
msgstr "Riceve questa email perché %{business} gliel’ha inviata tramite %{product}."

msgid "This email was sent automatically by %{product}."
msgstr "Questa email è stata inviata automaticamente da %{product}."

msgid "If the button doesn't work, copy this link into your browser:"
msgstr "Se il pulsante non funziona, copi questo link nel browser:"

msgid "If you didn't ask for this, you can safely ignore this email."
msgstr "Se non ha richiesto Lei questa operazione, può ignorare questa email."

msgid "You're receiving this email because you are the billing contact of %{company} at %{business}."
msgstr "Riceve questa email perché %{business} l’ha indicata come referente per la fatturazione di %{company}."

msgid "This link works only once."
msgstr "Questo link funziona una sola volta."

msgid "Hello %{name},"
msgstr "Gentile %{name},"

msgid "Hello,"
msgstr "Salve,"

# ADR-208: security notices

msgid "You're receiving this security notice because it concerns your %{product} account. Security notices can't be turned off."
msgstr "Riceve questo avviso di sicurezza perché riguarda il Suo account %{product}. Gli avvisi di sicurezza non si possono disattivare."

msgid "%{product} app"
msgstr "App %{product}"

msgid "%{product} app on %{platform}"
msgstr "App %{product} su %{platform}"

msgid "%{client} on %{platform}"
msgstr "%{client} su %{platform}"

msgid "Your password was changed"
msgstr "La Sua password è stata cambiata"

msgid "The password of your %{product} account was changed in Settings."
msgstr "La password del Suo account %{product} è stata cambiata nelle Impostazioni."

msgid "Your password was reset"
msgstr "La Sua password è stata reimpostata"

msgid "The password of your %{product} account was reset, and every device was signed out."
msgstr "La password del Suo account %{product} è stata reimpostata e tutti i dispositivi sono stati disconnessi."

msgid "Someone signed in to your %{product} account asked to change its email address to %{email}. Nothing changes until the new address is confirmed."
msgstr "Una persona collegata al Suo account %{product} ha chiesto di cambiarne l’indirizzo email in %{email}. Non cambia nulla finché il nuovo indirizzo non viene confermato."

msgid "Someone signed in to your %{product} account asked to change its email address. Nothing changes until the new address is confirmed."
msgstr "Una persona collegata al Suo account %{product} ha chiesto di cambiarne l’indirizzo email. Non cambia nulla finché il nuovo indirizzo non viene confermato."

msgid "A change of your email address was requested"
msgstr "È stata chiesta la modifica del Suo indirizzo email"

msgid "The email address of your %{product} account was changed to %{email}. Emails about your account now go there."
msgstr "L’indirizzo email del Suo account %{product} è stato cambiato in %{email}. Le email sul Suo account ora arrivano lì."

msgid "The email address of your %{product} account was changed. Emails about your account now go to the new address."
msgstr "L’indirizzo email del Suo account %{product} è stato cambiato. Le email sul Suo account ora arrivano al nuovo indirizzo."

msgid "Your email address was changed"
msgstr "Il Suo indirizzo email è stato cambiato"

msgid "If this was you, there's nothing else to do."
msgstr "Se è stato Lei, non deve fare altro."

msgid "If this wasn't you, undo the change right away. Then sign out everywhere and choose a new password."
msgstr "Se non è stato Lei, annulli subito la modifica. Poi esca da tutti i dispositivi e scelga una nuova password."

msgid "Undo this change"
msgstr "Annulla questa modifica"

msgid "A recovery code was used"
msgstr "È stato usato un codice di recupero"

msgid "One of your recovery codes was used to set a new password for your %{product} account, and every device was signed out."
msgstr "Uno dei Suoi codici di recupero è stato usato per impostare una nuova password del Suo account %{product}, e tutti i dispositivi sono stati disconnessi."

msgid "New recovery codes were created"
msgstr "Sono stati creati nuovi codici di recupero"

msgid "New recovery codes were created for your %{product} account. The old codes no longer work."
msgstr "Sono stati creati nuovi codici di recupero per il Suo account %{product}. I vecchi codici non funzionano più."

msgid "You have no unused recovery codes left."
msgstr "Non Le resta nessun codice di recupero inutilizzato."

msgid "You have only one unused recovery code left."
msgstr "Le resta un solo codice di recupero inutilizzato."

msgid "You have only two unused recovery codes left."
msgstr "Le restano solo due codici di recupero inutilizzati."

msgid "You're running out of recovery codes"
msgstr "I Suoi codici di recupero stanno finendo"

msgid "Create new codes in Settings and keep them somewhere safe, so you can always get back into your account."
msgstr "Crei nuovi codici nelle Impostazioni e li conservi in un posto sicuro, così potrà sempre rientrare nel Suo account."

msgid "Open Settings"
msgstr "Apri Impostazioni"

msgid "You were signed out everywhere"
msgstr "Tutti i Suoi dispositivi sono stati disconnessi"

msgid "Every device signed in to your %{product} account was signed out."
msgstr "Tutti i dispositivi collegati al Suo account %{product} sono stati disconnessi."

msgid "If this wasn't you, choose a new password right away."
msgstr "Se non è stato Lei, scelga subito una nuova password."

msgid "Choose a new password"
msgstr "Scegli una nuova password"

msgid "A new profile was added to your %{product} account: %{profile}."
msgstr "Al Suo account %{product} è stato aggiunto un nuovo profilo: %{profile}."

msgid "A new profile was added to your %{product} account."
msgstr "Al Suo account %{product} è stato aggiunto un nuovo profilo."

msgid "A profile was added to your account"
msgstr "Un profilo è stato aggiunto al Suo account"

msgid "New sign-in to your account"
msgstr "Nuovo accesso al Suo account"

msgid "Your %{product} account was just used to sign in on a device it hasn't been used on before."
msgstr "È appena stato effettuato l’accesso al Suo account %{product} da un dispositivo mai usato prima."

msgid "Your profile will be deleted"
msgstr "Il Suo profilo verrà eliminato"

msgid "Your profile %{profile} on %{product} will be deleted on %{date}."
msgstr "Il Suo profilo %{profile} su %{product} verrà eliminato il %{date}."

msgid "Your account will be deleted"
msgstr "Il Suo account verrà eliminato"

msgid "Your %{product} account and all its profiles will be deleted on %{date}."
msgstr "Il Suo account %{product} e tutti i suoi profili verranno eliminati il %{date}."

msgid "Changed your mind? You can undo it until then."
msgstr "Ha cambiato idea? Può annullare fino ad allora."

msgid "If this wasn't you, undo the deletion right away. Then sign out everywhere and choose a new password."
msgstr "Se non è stato Lei, annulli subito l’eliminazione. Poi esca da tutti i dispositivi e scelga una nuova password."

msgid "Undo the deletion"
msgstr "Annulla l’eliminazione"

msgid "Your profile was deleted"
msgstr "Il Suo profilo è stato eliminato"

msgid "Your profile %{profile} on %{product} was deleted, as you asked."
msgstr "Il Suo profilo %{profile} su %{product} è stato eliminato, come ha chiesto."

msgid "Your account was deleted"
msgstr "Il Suo account è stato eliminato"

msgid "Your %{product} account and all its profiles were deleted, as you asked."
msgstr "Il Suo account %{product} e tutti i suoi profili sono stati eliminati, come ha chiesto."

msgid "If this wasn't you, sign out everywhere right away, then choose a new password."
msgstr "Se non è stato Lei, esca subito da tutti i dispositivi e poi scelga una nuova password."

msgid "Sign out everywhere"
msgstr "Esci da tutti i dispositivi"

msgid "The sign-out link signs out every device, including this one, and works for 7 days."
msgstr "Il link di disconnessione scollega tutti i dispositivi, compreso questo, e vale 7 giorni."

msgid "When"
msgstr "Quando"

msgid "Device"
msgstr "Dispositivo"

msgid "Location"
msgstr "Luogo"

msgid "IP address"
msgstr "Indirizzo IP"
