msgid "%{box} no longer co-hosts «%{event}»."
msgstr "لم يعد %{box} يشارك في استضافة «%{event}»."

# ADR-187: a password reset request (handlers) and the reset itself (the person).
msgid "Password reset request"
msgstr "طلب إعادة تعيين كلمة المرور"

msgid "%{name} (@%{handle}) can't sign in and asked for a password reset."
msgstr "لا يستطيع %{name} (@%{handle}) تسجيل الدخول وطلب إعادة تعيين كلمة المرور."

msgid "Your password was reset"
msgstr "تمت إعادة تعيين كلمة مرورك"

