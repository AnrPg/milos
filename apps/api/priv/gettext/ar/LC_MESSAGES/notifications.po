msgid "New booking request"
msgstr "طلب حجز جديد"

msgid "Booking approved"
msgstr "تمت الموافقة على الحجز"

msgid "Booking rejected"
msgstr "تم رفض الحجز"

msgid "Booking timed out"
msgstr "انتهت مهلة الحجز"

msgid "Open the schedule to review the latest booking state."
msgstr "افتح الجدول لمراجعة حالة الحجز الأخيرة."

msgid "Workout annotation"
msgstr "شرح التمرين"

msgid "A workout annotation needs review."
msgstr "يحتاج التعليق التوضيحي للتمرين إلى المراجعة."

msgid "Workout changed"
msgstr "تم تغيير التمرين"

msgid "Your coach changed a scheduled workout."
msgstr "قام مدربك بتغيير التمرين المقرر."

msgid "Workout removed"
msgstr "تمت إزالة التمرين"

msgid "Your coach removed a scheduled workout."
msgstr "قام مدربك بإزالة تمرين مجدول."

msgid "Workout rejected"
msgstr "تم رفض التمرين"

msgid "An athlete"
msgstr "رياضي"

msgid "a workout"
msgstr "تجريب"

msgid "%{nickname} rejected %{title}."
msgstr "%{nickname} مرفوض %{title}."

msgid "Workout rescheduled"
msgstr "تمت إعادة جدولة التمرين"

msgid "An athlete rescheduled their workout."
msgstr "قام أحد الرياضيين بإعادة جدولة تمرينهم."

msgid "Message from %{nickname}"
msgstr "رسالة من %{nickname}"

msgid "%{nickname} sent you a message."
msgstr "%{nickname} أرسل لك رسالة."

msgid "Message from your coach"
msgstr "رسالة من مدربك"

msgid "Your coach sent you a message."
msgstr "أرسل لك مدربك رسالة."

msgid "Message from the box"
msgstr "رسالة من النادي"

msgid "Your gym sent you a message."
msgstr "أرسل لك ناديك رسالة."

msgid "Challenge completed"
msgstr "اكتمل التحدي"

msgid "You completed a challenge."
msgstr "لقد أكملت التحدي."

msgid "New message in your workout thread"
msgstr "رسالة جديدة في موضوع التمرين"

msgid "New message"
msgstr "رسالة جديدة"

msgid "You received a new message."
msgstr "لقد تلقيت رسالة جديدة."

msgid "TrainingJournal"
msgstr "تدريب ميلوس"

msgid "You have a new notification."
msgstr "لديك إشعار جديد."

msgid "invoice"
msgstr "فاتورة"

msgid "New invoice"
msgstr "فاتورة جديدة"

msgid "Invoice %{invoice_number} has been issued for your account."
msgstr "تم إصدار الفاتورة %{invoice_number} لحسابك."

msgid "Payment reminder"
msgstr "تذكير بالدفع"

msgid "You have an outstanding balance of %{amount} due."
msgstr "لديك رصيد مستحق بقيمة %{amount}."

msgid "Workout assignment requested"
msgstr "تم طلب تعيين تمرين"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "طلب %{nickname} تعيين تمرين بتاريخ %{requested_for}."

msgid "a requested date"
msgstr "تاريخ مطلوب"

msgid "New review submitted"
msgstr "تم إرسال مراجعة جديدة"

msgid "general"
msgstr "عامة"

msgid "A %{target_type} review was submitted with a %{rating}/5 rating."
msgstr "تم إرسال مراجعة من نوع %{target_type} بتقييم %{rating}/5."

msgid "A new %{target_type} review needs attention."
msgstr "تحتاج مراجعة جديدة من نوع %{target_type} إلى الاهتمام."

msgid "Class bookings approved"
msgstr "تمت الموافقة على حجوزات الصفوف"

msgid "Your coach approved one or more class booking requests."
msgstr "وافق مدربك على طلب واحد أو أكثر لحجز الصفوف."

msgid "New workouts assigned"
msgstr "تم تعيين تمارين جديدة"

msgid "Your coach assigned one or more workouts to you."
msgstr "عيّن لك مدربك تمرينًا واحدًا أو أكثر."

msgid "You got a spot"
msgstr "حصلت على مكان"

msgid "A place opened up in %{class}. Your booking is confirmed or awaiting approval."
msgstr "توفر مكان في %{class}. حجزك مؤكد أو بانتظار الموافقة."

msgid "Your package ends soon"
msgstr "باقتك تنتهي قريبًا"

msgid "%{package} ends on %{date}."
msgstr "تنتهي %{package} في %{date}."

msgid "New form review request"
msgstr "طلب جديد لمراجعة الأداء"

msgid "%{client} sent a video for feedback."
msgstr "أرسل %{client} فيديو للحصول على ملاحظات."

msgid "Your form review is ready"
msgstr "مراجعة أدائك جاهزة"

msgid "Your coach left feedback on your video."
msgstr "ترك مدربك ملاحظات على الفيديو الخاص بك."

msgid "A client is waiting for a reply"
msgstr "عميل ينتظر الرد"

msgid "%{client} has been waiting longer than the promised reply time."
msgstr "ينتظر %{client} أكثر من وقت الرد الموعود."

msgid "Your nutrition plan was updated"
msgstr "تم تحديث خطتك الغذائية"

msgid "Open it to see what changed."
msgstr "افتحها لمعرفة ما تغيّر."

msgid "New appointment booked"
msgstr "تم حجز موعد جديد"

msgid "%{client} booked a session for %{time}."
msgstr "حجز %{client} جلسة في %{time}."

msgid "Appointment cancelled"
msgstr "تم إلغاء الموعد"

msgid "The session on %{time} was cancelled."
msgstr "تم إلغاء الجلسة في %{time}."

msgid "A coach took a new athlete"
msgstr "تولّى مدرب رياضيًا جديدًا"

msgid "%{coach} is now coaching %{client}."
msgstr "يدرّب %{coach} الآن %{client}."

msgid "An admin read your note"
msgstr "قرأ مسؤول ملاحظتك"

msgid "%{reader} read your note about %{client} at %{time}."
msgstr "قرأ %{reader} ملاحظتك عن %{client} في %{time}."

msgid "A machine needs attention"
msgstr "جهاز يحتاج إلى انتباه"

msgid "%{machine}: %{note}"
msgstr "%{machine}: %{note}"

msgid "Reported running low"
msgstr "تم الإبلاغ عن انخفاض المخزون"

msgid "%{item}: %{note}"
msgstr "%{item}: %{note}"

msgid "Inventory today"
msgstr "المخزون اليوم"

msgid "Needs attention: %{items}"
msgstr "يحتاج إلى انتباه: %{items}"

msgid "Running low"
msgstr "المخزون منخفض"

msgid "%{item}: %{quantity} left."
msgstr "%{item}: تبقّى %{quantity}."

msgid "Your subscription ends soon"
msgstr "اشتراكك ينتهي قريبًا"

msgid "Your subscription has ended"
msgstr "انتهى اشتراكك"

msgid "your subscription"
msgstr "اشتراكك"

msgid "%{package} ends on %{date} (in %{days} days). Renew to keep booking classes."
msgstr "ينتهي %{package} في %{date} (بعد %{days} أيام). جدّد لتواصل حجز الحصص."

msgid "%{package} has ended. You keep access until %{date}; renew before then to keep booking classes."
msgstr "انتهى %{package}. يبقى وصولك متاحًا حتى %{date}؛ جدّد قبل ذلك لتواصل حجز الحصص."

msgid "Your access has ended"
msgstr "انتهى وصولك"

msgid "Your access is paused because a payment is overdue. Pay the outstanding balance to book classes again."
msgstr "تم إيقاف وصولك مؤقتًا بسبب دفعة متأخرة. ادفع الرصيد المستحق لتحجز الحصص مجددًا."

msgid "Your access has ended. Renew your subscription to book classes again."
msgstr "انتهى وصولك. جدّد اشتراكك لتحجز الحصص مجددًا."

msgid "Your upcoming bookings were cancelled: %{count}."
msgstr "أُلغيت حجوزاتك القادمة: %{count}."

msgid "Follow request"
msgstr "طلب متابعة"

msgid "%{nickname} wants to follow you."
msgstr "يريد %{nickname} متابعتك."

msgid "Follow request accepted"
msgstr "تم قبول طلب المتابعة"

msgid "You now follow %{nickname}."
msgstr "أنت تتابع %{nickname} الآن."

msgid "Trial request"
msgstr "طلب حصة تجريبية"

msgid "%{nickname} asks to try %{class} (%{when})."
msgstr "%{nickname} يطلب تجربة %{class} (%{when})."

msgid "New trial"
msgstr "حصة تجريبية جديدة"

msgid "%{nickname} booked a trial in %{class} (%{when})."
msgstr "حجز %{nickname} حصة تجريبية في %{class} (%{when})."

msgid "Trial cancelled"
msgstr "أُلغيت حصة تجريبية"

msgid "%{nickname} cancelled their trial in %{class}."
msgstr "ألغى %{nickname} حصته التجريبية في %{class}."

msgid "Your trial is booked"
msgstr "تم حجز حصتك التجريبية"

msgid "%{box}: %{class} (%{when})."
msgstr "%{box}: %{class} (%{when})."

msgid "Trial not accepted"
msgstr "لم تُقبل الحصة التجريبية"

msgid "%{box} couldn't take you in %{class}."
msgstr "لا يستطيع %{box} استقبالك في %{class}."

msgid "Your trial is soon"
msgstr "حصتك التجريبية قريبة"

msgid "%{class} at %{box} (%{when})."
msgstr "%{class} في %{box} (%{when})."

msgid "How was your trial?"
msgstr "كيف كانت حصتك التجريبية؟"

msgid "Want to keep training at %{box}? Send them a message."
msgstr "هل تريد مواصلة التدريب في %{box}؟ أرسل لهم رسالة."

msgid "Trial class cancelled"
msgstr "أُلغيت حصة التجربة"

msgid "%{box} cancelled %{class} (%{when}). Pick another class."
msgstr "ألغى %{box} حصة %{class} (%{when}). اختر حصة أخرى."

msgid "New group to review"
msgstr "مجموعة جديدة للمراجعة"

msgid "%{nickname} wants to start «%{group}»."
msgstr "%{nickname} يريد إنشاء «%{group}»."

msgid "Your group is live"
msgstr "مجموعتك نشطة"

msgid "«%{group}» is open. Invite people in."
msgstr "«%{group}» مفتوحة. ادعُ الناس."

msgid "Group not approved"
msgstr "لم تتم الموافقة على المجموعة"

msgid "The box didn't approve «%{group}»."
msgstr "لم يوافق النادي على «%{group}»."

msgid "Request to join"
msgstr "طلب انضمام"

msgid "%{nickname} asks to join «%{group}»."
msgstr "%{nickname} يطلب الانضمام إلى «%{group}»."

msgid "You're in"
msgstr "أنت عضو الآن"

msgid "You joined «%{group}»."
msgstr "انضممت إلى «%{group}»."

msgid "Your group is quiet"
msgstr "مجموعتك هادئة"

msgid "Nobody has posted in «%{group}» for a while. Post something or it will be archived."
msgstr "لم ينشر أحد في «%{group}» منذ فترة. انشر شيئًا وإلا ستُؤرشف."

msgid "New report"
msgstr "بلاغ جديد"

msgid "Someone reported something in the club."
msgstr "أبلغ أحدهم عن شيء في النادي."

msgid "A place opened up"
msgstr "توفّر مكان"

msgid "You're going to «%{event}» (%{when})."
msgstr "أنت ذاهب إلى «%{event}» (%{when})."

msgid "Event cancelled"
msgstr "أُلغي الحدث"

msgid "«%{event}» (%{when}) was cancelled."
msgstr "أُلغي «%{event}» (%{when})."

msgid "«%{event}» (%{when}) was cancelled: %{reason}"
msgstr "أُلغي «%{event}» (%{when}): %{reason}"

msgid "Event changed"
msgstr "تغيّر الحدث"

msgid "«%{event}» moved to %{when}."
msgstr "نُقل «%{event}» إلى %{when}."

msgid "«%{event}» has a new place."
msgstr "لـ«%{event}» مكان جديد."

msgid "«%{event}» has a new time and place: %{when}."
msgstr "لـ«%{event}» وقت ومكان جديدان: %{when}."

msgid "Starting soon"
msgstr "يبدأ قريبًا"

msgid "«%{event}» starts in two hours (%{when})."
msgstr "يبدأ «%{event}» بعد ساعتين (%{when})."

msgid "Your guest is coming"
msgstr "ضيفك قادم"

msgid "%{nickname} is coming to «%{event}» with your guest pass."
msgstr "%{nickname} قادم إلى «%{event}» بدعوة الضيف الخاصة بك."

msgid "Try a class"
msgstr "جرّب حصة"

msgid "Liked «%{event}»? %{box} invites you to a trial class."
msgstr "هل أعجبك «%{event}»؟ يدعوك %{box} إلى حصة تجريبية."

msgid "Message about «%{event}»"
msgstr "رسالة حول «%{event}»"

msgid "Your invite"
msgstr "دعوتك"

msgid "%{nickname} signed up with your invite."
msgstr "سجّل %{nickname} عبر دعوتك."

msgid "%{nickname} came to the event you invited them to."
msgstr "حضر %{nickname} الفعالية التي دعوته إليها."

msgid "%{nickname} came to a trial."
msgstr "حضر %{nickname} حصة تجريبية."

msgid "%{nickname} subscribed. Your reward is waiting for approval."
msgstr "اشترك %{nickname}. مكافأتك بانتظار الموافقة."

msgid "Referral reward"
msgstr "مكافأة الإحالة"

msgid "Your referral reward was given."
msgstr "تم منحك مكافأة الإحالة."

msgid "Your referral was not approved."
msgstr "لم تتم الموافقة على إحالتك."

msgid "Your referral reward was approved."
msgstr "تمت الموافقة على مكافأة إحالتك."

msgid "Referral to approve"
msgstr "إحالة بانتظار الموافقة"

msgid "%{nickname} subscribed, invited by %{referrer}."
msgstr "اشترك %{nickname} بدعوة من %{referrer}."
