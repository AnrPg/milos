msgid ""
msgstr ""
"Language: ar\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "You're receiving this email because you have a %{product} account."
msgstr "تصلكم هذه الرسالة لأن لديكم حسابًا على %{product}."

msgid "You're receiving this email because %{business} sent it to you through %{product}."
msgstr "أُرسلت إليكم هذه الرسالة من %{business} عبر %{product}."

msgid "This email was sent automatically by %{product}."
msgstr "أُرسلت هذه الرسالة تلقائيًا من %{product}."

msgid "If the button doesn't work, copy this link into your browser:"
msgstr "إذا لم يعمل الزر، انسخوا هذا الرابط والصقوه في المتصفح:"

msgid "If you didn't ask for this, you can safely ignore this email."
msgstr "إذا لم تطلبوا ذلك، يمكنكم تجاهل هذه الرسالة بأمان."

msgid "You're receiving this email because you are the billing contact of %{company} at %{business}."
msgstr "تصلكم هذه الرسالة لأنكم مسجّلون لدى %{business} بوصفكم جهة الاتصال للفواتير الخاصة بـ%{company}."

msgid "This link works only once."
msgstr "يعمل هذا الرابط مرة واحدة فقط."

msgid "Hello %{name},"
msgstr "مرحبًا %{name}،"

msgid "Hello,"
msgstr "مرحبًا،"

# ADR-213: verify_email

msgid "Confirm your email address"
msgstr "أكّدوا عنوان بريدكم الإلكتروني"

msgid "Please confirm that %{email} is your email address. It lets you get back into your account if you ever forget your password."
msgstr "يُرجى تأكيد أن %{email} هو عنوان بريدكم الإلكتروني. سيتيح لكم ذلك العودة إلى حسابكم إذا نسيتم كلمة المرور يومًا ما."

msgid "Confirm email"
msgstr "تأكيد البريد الإلكتروني"

msgid "This link expires in 48 hours."
msgstr "تنتهي صلاحية هذا الرابط خلال 48 ساعة."

msgid "If you didn't create a %{product} account, you can ignore this email."
msgstr "إذا لم تُنشئوا حسابًا على %{product}، يمكنكم تجاهل هذه الرسالة."
msgid "Activate %{business} on %{product}"
msgstr "فعّلوا «%{business}» على %{product}"
msgid "Your business is ready to go live"
msgstr "نشاطكم التجاري جاهز للانطلاق"
msgid "The %{product} team approved %{business}. Open the link while signed in to your account to activate it: the demo data is removed and the business goes live."
msgstr "وافق فريق %{product} على «%{business}». افتحوا الرابط وأنتم مسجّلو الدخول إلى حسابكم لتفعيله: تُحذف البيانات التجريبية ويبدأ النشاط التجاري بالعمل."
msgid "Your role: owner."
msgstr "دوركم: المالك."
msgid "Your role: admin."
msgstr "دوركم: مشرف."
msgid "Activate business"
msgstr "تفعيل النشاط التجاري"
msgid "It opens only for your own account."
msgstr "لا يُفتح إلا لحسابكم أنتم."
# ADR-208: security notices
msgid "You're receiving this security notice because it concerns your %{product} account. Security notices can't be turned off."
msgstr "يصلكم هذا التنبيه الأمني لأنه يخص حسابكم على %{product}. لا يمكن إيقاف التنبيهات الأمنية."
msgid "%{product} app"
msgstr "تطبيق %{product}"
msgid "%{product} app on %{platform}"
msgstr "تطبيق %{product} على %{platform}"
msgid "%{client} on %{platform}"
msgstr "%{client} على %{platform}"
msgid "Your password was changed"
msgstr "تم تغيير كلمة المرور"
msgid "The password of your %{product} account was changed in Settings."
msgstr "تم تغيير كلمة مرور حسابكم على %{product} من الإعدادات."
msgid "Your password was reset"
msgstr "تمت إعادة تعيين كلمة المرور"
msgid "The password of your %{product} account was reset, and every device was signed out."
msgstr "تمت إعادة تعيين كلمة مرور حسابكم على %{product}، وتم تسجيل الخروج من جميع الأجهزة."
msgid "Someone signed in to your %{product} account asked to change its email address to %{email}. Nothing changes until the new address is confirmed."
msgstr "طلب شخص مسجّل الدخول إلى حسابكم على %{product} تغيير عنوان البريد الإلكتروني إلى %{email}. لن يتغير شيء حتى يتم تأكيد العنوان الجديد."
msgid "Someone signed in to your %{product} account asked to change its email address. Nothing changes until the new address is confirmed."
msgstr "طلب شخص مسجّل الدخول إلى حسابكم على %{product} تغيير عنوان البريد الإلكتروني. لن يتغير شيء حتى يتم تأكيد العنوان الجديد."
msgid "A change of your email address was requested"
msgstr "طُلب تغيير عنوان بريدكم الإلكتروني"
msgid "The email address of your %{product} account was changed to %{email}. Emails about your account now go there."
msgstr "تم تغيير عنوان البريد الإلكتروني لحسابكم على %{product} إلى %{email}. ستصل الرسائل الخاصة بحسابكم إليه من الآن."
msgid "The email address of your %{product} account was changed. Emails about your account now go to the new address."
msgstr "تم تغيير عنوان البريد الإلكتروني لحسابكم على %{product}. ستصل الرسائل الخاصة بحسابكم إلى العنوان الجديد من الآن."
msgid "Your email address was changed"
msgstr "تم تغيير عنوان بريدكم الإلكتروني"
msgid "If this was you, there's nothing else to do."
msgstr "إذا كنتم أنتم من قام بذلك، فلا حاجة لفعل أي شيء آخر."
msgid "If this wasn't you, undo the change right away. Then sign out everywhere and choose a new password."
msgstr "إذا لم تكونوا أنتم، فتراجعوا عن التغيير فورًا. ثم سجّلوا الخروج من كل مكان واختاروا كلمة مرور جديدة."
msgid "Undo this change"
msgstr "التراجع عن هذا التغيير"
msgid "A recovery code was used"
msgstr "تم استخدام رمز استرداد"
msgid "One of your recovery codes was used to set a new password for your %{product} account, and every device was signed out."
msgstr "تم استخدام أحد رموز الاسترداد الخاصة بكم لتعيين كلمة مرور جديدة لحسابكم على %{product}، وتم تسجيل الخروج من جميع الأجهزة."
msgid "New recovery codes were created"
msgstr "تم إنشاء رموز استرداد جديدة"
msgid "New recovery codes were created for your %{product} account. The old codes no longer work."
msgstr "تم إنشاء رموز استرداد جديدة لحسابكم على %{product}. لم تعد الرموز القديمة تعمل."
msgid "You have no unused recovery codes left."
msgstr "لم يتبقَّ لديكم أي رمز استرداد غير مستخدم."
msgid "You have only one unused recovery code left."
msgstr "تبقّى لديكم رمز استرداد واحد فقط غير مستخدم."
msgid "You have only two unused recovery codes left."
msgstr "تبقّى لديكم رمزا استرداد فقط غير مستخدمين."
msgid "You're running out of recovery codes"
msgstr "رموز الاسترداد لديكم على وشك النفاد"
msgid "Create new codes in Settings and keep them somewhere safe, so you can always get back into your account."
msgstr "أنشئوا رموزًا جديدة من الإعدادات واحفظوها في مكان آمن، لتتمكنوا دائمًا من العودة إلى حسابكم."
msgid "Open Settings"
msgstr "فتح الإعدادات"
msgid "You were signed out everywhere"
msgstr "تم تسجيل خروجكم من كل مكان"
msgid "Every device signed in to your %{product} account was signed out."
msgstr "تم تسجيل الخروج من كل جهاز كان مسجّل الدخول إلى حسابكم على %{product}."
msgid "If this wasn't you, choose a new password right away."
msgstr "إذا لم تكونوا أنتم، فاختاروا كلمة مرور جديدة فورًا."
msgid "Choose a new password"
msgstr "اختيار كلمة مرور جديدة"
msgid "A new profile was added to your %{product} account: %{profile}."
msgstr "تمت إضافة ملف شخصي جديد إلى حسابكم على %{product}: %{profile}."
msgid "A new profile was added to your %{product} account."
msgstr "تمت إضافة ملف شخصي جديد إلى حسابكم على %{product}."
msgid "A profile was added to your account"
msgstr "تمت إضافة ملف شخصي إلى حسابكم"
msgid "New sign-in to your account"
msgstr "تسجيل دخول جديد إلى حسابكم"
msgid "Your %{product} account was just used to sign in on a device it hasn't been used on before."
msgstr "تم للتو تسجيل الدخول إلى حسابكم على %{product} من جهاز لم يُستخدم معه من قبل."
msgid "Your profile will be deleted"
msgstr "سيتم حذف ملفكم الشخصي"
msgid "Your profile %{profile} on %{product} will be deleted on %{date}."
msgstr "سيتم حذف ملفكم الشخصي %{profile} على %{product} في %{date}."
msgid "Your account will be deleted"
msgstr "سيتم حذف حسابكم"
msgid "Your %{product} account and all its profiles will be deleted on %{date}."
msgstr "سيتم حذف حسابكم على %{product} وجميع ملفاته الشخصية في %{date}."
msgid "Changed your mind? You can undo it until then."
msgstr "هل غيّرتم رأيكم؟ يمكنكم التراجع حتى ذلك الحين."
msgid "If this wasn't you, undo the deletion right away. Then sign out everywhere and choose a new password."
msgstr "إذا لم تكونوا أنتم، فتراجعوا عن الحذف فورًا. ثم سجّلوا الخروج من كل مكان واختاروا كلمة مرور جديدة."
msgid "Undo the deletion"
msgstr "التراجع عن الحذف"
msgid "Your profile was deleted"
msgstr "تم حذف ملفكم الشخصي"
msgid "Your profile %{profile} on %{product} was deleted, as you asked."
msgstr "تم حذف ملفكم الشخصي %{profile} على %{product} كما طلبتم."
msgid "Your account was deleted"
msgstr "تم حذف حسابكم"
msgid "Your %{product} account and all its profiles were deleted, as you asked."
msgstr "تم حذف حسابكم على %{product} وجميع ملفاته الشخصية كما طلبتم."
msgid "If this wasn't you, sign out everywhere right away, then choose a new password."
msgstr "إذا لم تكونوا أنتم، فسجّلوا الخروج من كل مكان فورًا، ثم اختاروا كلمة مرور جديدة."
msgid "Sign out everywhere"
msgstr "تسجيل الخروج من كل مكان"
msgid "The sign-out link signs out every device, including this one, and works for 7 days."
msgstr "يسجّل رابط الخروج الخروج من جميع الأجهزة، بما فيها هذا الجهاز، ويعمل لمدة 7 أيام."
msgid "When"
msgstr "متى"
msgid "Device"
msgstr "الجهاز"
msgid "Location"
msgstr "الموقع"
msgid "IP address"
msgstr "عنوان IP"
msgid "Reset your %{product} password"
msgstr "إعادة تعيين كلمة مرور %{product}"
msgid "Reset your password"
msgstr "إعادة تعيين كلمة المرور"
msgid "Someone asked to reset the password of your %{product} account. To choose a new password, use the button below."
msgstr "طُلبت إعادة تعيين كلمة مرور حسابك على %{product}. لاختيار كلمة مرور جديدة، استخدم الزر أدناه."
msgid "This link works for 1 hour."
msgstr "يعمل هذا الرابط لمدة ساعة واحدة."
msgid "Setting a new password signs you out on every device."
msgstr "عند تعيين كلمة مرور جديدة، سيتم تسجيل خروجك من جميع أجهزتك."
msgid "Your password has not been changed."
msgstr "لم تتغير كلمة المرور الخاصة بك."
