msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "New booking request"
msgstr "Новый запрос на бронирование"

msgid "Booking approved"
msgstr "Бронирование одобрено"

msgid "Booking rejected"
msgstr "Бронирование отклонено"

msgid "Booking timed out"
msgstr "Время бронирования истекло"

msgid "Open the schedule to review the latest booking state."
msgstr "Откройте расписание, чтобы просмотреть последнее состояние бронирования."

msgid "Workout annotation"
msgstr "Аннотация к тренировке"

msgid "A workout annotation needs review."
msgstr "Аннотацию тренировки необходимо просмотреть."

msgid "Workout changed"
msgstr "Тренировка изменена"

msgid "Your coach changed a scheduled workout."
msgstr "Ваш тренер изменил расписание тренировки."

msgid "Workout removed"
msgstr "Тренировка удалена."

msgid "Your coach removed a scheduled workout."
msgstr "Ваш тренер удалил запланированную тренировку."

msgid "Workout rejected"
msgstr "Тренировка отклонена"

msgid "An athlete"
msgstr "Спортсмен"

msgid "a workout"
msgstr "тренировка"

msgid "%{nickname} rejected %{title}."
msgstr "%{nickname} отклонил %{title}."

msgid "Workout rescheduled"
msgstr "Тренировка перенесена"

msgid "An athlete rescheduled their workout."
msgstr "Спортсмен перенес тренировку."

msgid "Message from %{nickname}"
msgstr "Сообщение от %{nickname}"

msgid "%{nickname} sent you a message."
msgstr "%{nickname} отправил вам сообщение."

msgid "New coach note"
msgstr "Новое замечание тренера"

msgid "Your coach added a new note."
msgstr "Ваш тренер добавил новую заметку."

msgid "Challenge completed"
msgstr "Вызов выполнен"

msgid "You completed a challenge."
msgstr "Вы выполнили задание."

msgid "New message in your workout thread"
msgstr "Новое сообщение в вашей теме тренировок."

msgid "New message"
msgstr "Новое сообщение"

msgid "You received a new message."
msgstr "Вы получили новое сообщение."

msgid "TrainingJournal"
msgstr "Милош Тренинг"

msgid "You have a new notification."
msgstr "У вас есть новое уведомление."

msgid "invoice"
msgstr "счет"

msgid "New invoice"
msgstr "Новый счет"

msgid "Invoice %{invoice_number} has been issued for your account."
msgstr "Для вашего аккаунта выставлен счет %{invoice_number}."

msgid "Payment reminder"
msgstr "Напоминание об оплате"

msgid "You have an outstanding balance of %{amount} due."
msgstr "У вас есть задолженность в размере %{amount}."

msgid "Workout assignment requested"
msgstr "Запрошено назначение тренировки"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "%{nickname} запросил(а) назначение тренировки на %{requested_for}."

msgid "a requested date"
msgstr "запрошенная дата"

msgid "New review submitted"
msgstr "Отправлен новый отзыв"

msgid "general"
msgstr "общий"

msgid "A %{target_type} review was submitted with a %{rating}/5 rating."
msgstr "Отзыв о %{target_type} отправлен с оценкой %{rating}/5."

msgid "A new %{target_type} review needs attention."
msgstr "Новый отзыв о %{target_type} требует внимания."

msgid "Class bookings approved"
msgstr "Записи на занятия одобрены"

msgid "Your coach approved one or more class booking requests."
msgstr "Ваш тренер одобрил один или несколько запросов на запись на занятия."

msgid "New workouts assigned"
msgstr "Назначены новые тренировки"

msgid "Your coach assigned one or more workouts to you."
msgstr "Ваш тренер назначил вам одну или несколько тренировок."

msgid "Your subscription ends soon"
msgstr "Ваша подписка скоро закончится"

msgid "Your subscription has ended"
msgstr "Ваша подписка закончилась"

msgid "your subscription"
msgstr "ваша подписка"

msgid "%{package} ends on %{date} (in %{days} days). Renew to keep booking classes."
msgstr "%{package} заканчивается %{date} (через %{days} дн.). Продлите, чтобы и дальше записываться на занятия."

msgid "%{package} has ended. You keep access until %{date}; renew before then to keep booking classes."
msgstr "%{package} закончилась. Доступ сохраняется до %{date}; продлите до этой даты, чтобы и дальше записываться на занятия."

msgid "Your access has ended"
msgstr "Ваш доступ закончился"

msgid "Your access is paused because a payment is overdue. Pay the outstanding balance to book classes again."
msgstr "Доступ приостановлен из-за просроченного платежа. Оплатите задолженность, чтобы снова записываться на занятия."

msgid "Your access has ended. Renew your subscription to book classes again."
msgstr "Доступ закончился. Продлите подписку, чтобы снова записываться на занятия."

msgid "Your upcoming bookings were cancelled: %{count}."
msgstr "Ваши предстоящие записи отменены: %{count}."
