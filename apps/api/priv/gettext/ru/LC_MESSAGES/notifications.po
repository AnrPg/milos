msgid "New booking request"
msgstr "Новый запрос на бронирование"

msgid "Booking approved"
msgstr "Бронирование одобрено"

msgid "Booking rejected"
msgstr "Бронирование отклонено"

msgid "Booking timed out"
msgstr "Время бронирования истекло"

msgid "Open the schedule to review the latest booking state."
msgstr "Откройте расписание, чтобы просмотреть последнее состояние бронирования."

msgid "Workout annotation"
msgstr "Аннотация к тренировке"

msgid "A workout annotation needs review."
msgstr "Аннотацию тренировки необходимо просмотреть."

msgid "Workout changed"
msgstr "Тренировка изменена"

msgid "Your coach changed a scheduled workout."
msgstr "Ваш тренер изменил расписание тренировки."

msgid "Workout removed"
msgstr "Тренировка удалена."

msgid "Your coach removed a scheduled workout."
msgstr "Ваш тренер удалил запланированную тренировку."

msgid "Workout rejected"
msgstr "Тренировка отклонена"

msgid "An athlete"
msgstr "Спортсмен"

msgid "a workout"
msgstr "тренировка"

msgid "%{nickname} rejected %{title}."
msgstr "%{nickname} отклонил %{title}."

msgid "Workout rescheduled"
msgstr "Тренировка перенесена"

msgid "An athlete rescheduled their workout."
msgstr "Спортсмен перенес тренировку."

msgid "Message from %{nickname}"
msgstr "Сообщение от %{nickname}"

msgid "%{nickname} sent you a message."
msgstr "%{nickname} отправил вам сообщение."

msgid "Message from your coach"
msgstr "Сообщение от вашего тренера"

msgid "Your coach sent you a message."
msgstr "Ваш тренер отправил вам сообщение."

msgid "Message from the box"
msgstr "Сообщение от зала"

msgid "Your gym sent you a message."
msgstr "Ваш зал отправил вам сообщение."

msgid "Challenge completed"
msgstr "Вызов выполнен"

msgid "You completed a challenge."
msgstr "Вы выполнили задание."

msgid "New message in your workout thread"
msgstr "Новое сообщение в вашей теме тренировок."

msgid "New message"
msgstr "Новое сообщение"

msgid "You received a new message."
msgstr "Вы получили новое сообщение."

msgid "TrainingJournal"
msgstr "Милош Тренинг"

msgid "You have a new notification."
msgstr "У вас есть новое уведомление."

msgid "invoice"
msgstr "счет"

msgid "New invoice"
msgstr "Новый счет"

msgid "Invoice %{invoice_number} has been issued for your account."
msgstr "Для вашего аккаунта выставлен счет %{invoice_number}."

msgid "Payment reminder"
msgstr "Напоминание об оплате"

msgid "You have an outstanding balance of %{amount} due."
msgstr "У вас есть задолженность в размере %{amount}."

msgid "Workout assignment requested"
msgstr "Запрошено назначение тренировки"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "%{nickname} запросил(а) назначение тренировки на %{requested_for}."

msgid "a requested date"
msgstr "запрошенная дата"

msgid "New review submitted"
msgstr "Отправлен новый отзыв"

msgid "general"
msgstr "общий"

msgid "A %{target_type} review was submitted with a %{rating}/5 rating."
msgstr "Отзыв о %{target_type} отправлен с оценкой %{rating}/5."

msgid "A new %{target_type} review needs attention."
msgstr "Новый отзыв о %{target_type} требует внимания."

msgid "Class bookings approved"
msgstr "Записи на занятия одобрены"

msgid "Your coach approved one or more class booking requests."
msgstr "Ваш тренер одобрил один или несколько запросов на запись на занятия."

msgid "New workouts assigned"
msgstr "Назначены новые тренировки"

msgid "Your coach assigned one or more workouts to you."
msgstr "Ваш тренер назначил вам одну или несколько тренировок."

msgid "You got a spot"
msgstr "Для вас освободилось место"

msgid "A place opened up in %{class}. Your booking is confirmed or awaiting approval."
msgstr "Освободилось место на занятии %{class}. Ваша запись подтверждена или ожидает одобрения."

msgid "Your package ends soon"
msgstr "Ваш пакет скоро закончится"

msgid "%{package} ends on %{date}."
msgstr "%{package} заканчивается %{date}."

msgid "New form review request"
msgstr "Новый запрос на разбор техники"

msgid "%{client} sent a video for feedback."
msgstr "%{client} отправил(а) видео на разбор."

msgid "Your form review is ready"
msgstr "Разбор вашей техники готов"

msgid "Your coach left feedback on your video."
msgstr "Тренер оставил отзыв о вашем видео."

msgid "A client is waiting for a reply"
msgstr "Клиент ждёт ответа"

msgid "%{client} has been waiting longer than the promised reply time."
msgstr "%{client} ждёт дольше обещанного времени ответа."

msgid "Your nutrition plan was updated"
msgstr "Ваш план питания обновлён"

msgid "Open it to see what changed."
msgstr "Откройте, чтобы увидеть изменения."

msgid "New appointment booked"
msgstr "Новая запись на сессию"

msgid "%{client} booked a session for %{time}."
msgstr "%{client} записался(-ась) на сессию на %{time}."

msgid "Appointment cancelled"
msgstr "Сессия отменена"

msgid "The session on %{time} was cancelled."
msgstr "Сессия %{time} отменена."

msgid "A coach took a new athlete"
msgstr "Тренер взял нового атлета"

msgid "%{coach} is now coaching %{client}."
msgstr "%{coach} теперь тренирует %{client}."

msgid "An admin read your note"
msgstr "Администратор прочитал вашу заметку"

msgid "%{reader} read your note about %{client} at %{time}."
msgstr "%{reader} прочитал(а) вашу заметку о %{client} в %{time}."

msgid "A machine needs attention"
msgstr "Тренажёр требует внимания"

msgid "%{machine}: %{note}"
msgstr "%{machine}: %{note}"

msgid "Reported running low"
msgstr "Сообщили о нехватке"

msgid "%{item}: %{note}"
msgstr "%{item}: %{note}"

msgid "Inventory today"
msgstr "Инвентарь сегодня"

msgid "Needs attention: %{items}"
msgstr "Требует внимания: %{items}"

msgid "Running low"
msgstr "Заканчивается"

msgid "%{item}: %{quantity} left."
msgstr "%{item}: осталось %{quantity}."

msgid "Your subscription ends soon"
msgstr "Ваша подписка скоро закончится"

msgid "Your subscription has ended"
msgstr "Ваша подписка закончилась"

msgid "your subscription"
msgstr "ваша подписка"

msgid "%{package} ends on %{date} (in %{days} days). Renew to keep booking classes."
msgstr "%{package} заканчивается %{date} (через %{days} дн.). Продлите, чтобы и дальше записываться на занятия."

msgid "%{package} has ended. You keep access until %{date}; renew before then to keep booking classes."
msgstr "%{package} закончилась. Доступ сохраняется до %{date}; продлите до этой даты, чтобы и дальше записываться на занятия."

msgid "Your access has ended"
msgstr "Ваш доступ закончился"

msgid "Your access is paused because a payment is overdue. Pay the outstanding balance to book classes again."
msgstr "Доступ приостановлен из-за просроченного платежа. Оплатите задолженность, чтобы снова записываться на занятия."

msgid "Your access has ended. Renew your subscription to book classes again."
msgstr "Доступ закончился. Продлите подписку, чтобы снова записываться на занятия."

msgid "Your upcoming bookings were cancelled: %{count}."
msgstr "Ваши предстоящие записи отменены: %{count}."

msgid "Follow request"
msgstr "Запрос на подписку"

msgid "%{nickname} wants to follow you."
msgstr "%{nickname} хочет подписаться на вас."

msgid "Follow request accepted"
msgstr "Запрос на подписку принят"

msgid "You now follow %{nickname}."
msgstr "Теперь вы подписаны на %{nickname}."

msgid "Trial request"
msgstr "Запрос на пробное занятие"

msgid "%{nickname} asks to try %{class} (%{when})."
msgstr "%{nickname} хочет попробовать %{class} (%{when})."

msgid "New trial"
msgstr "Новое пробное занятие"

msgid "%{nickname} booked a trial in %{class} (%{when})."
msgstr "%{nickname} записался(-ась) на пробное занятие %{class} (%{when})."

msgid "Trial cancelled"
msgstr "Пробное занятие отменено"

msgid "%{nickname} cancelled their trial in %{class}."
msgstr "%{nickname} отменил(а) пробное занятие %{class}."

msgid "Your trial is booked"
msgstr "Пробное занятие забронировано"

msgid "%{box}: %{class} (%{when})."
msgstr "%{box}: %{class} (%{when})."

msgid "Trial not accepted"
msgstr "Пробное занятие не принято"

msgid "%{box} couldn't take you in %{class}."
msgstr "%{box} не может принять вас на %{class}."

msgid "Your trial is soon"
msgstr "Скоро ваше пробное занятие"

msgid "%{class} at %{box} (%{when})."
msgstr "%{class} в %{box} (%{when})."

msgid "How was your trial?"
msgstr "Как прошло пробное занятие?"

msgid "Want to keep training at %{box}? Send them a message."
msgstr "Хотите продолжить в %{box}? Напишите им."

msgid "Trial class cancelled"
msgstr "Занятие отменено"

msgid "%{box} cancelled %{class} (%{when}). Pick another class."
msgstr "%{box} отменил %{class} (%{when}). Выберите другое занятие."

msgid "New group to review"
msgstr "Новая группа на проверку"

msgid "%{nickname} wants to start «%{group}»."
msgstr "%{nickname} хочет создать «%{group}»."

msgid "Your group is live"
msgstr "Ваша группа активна"

msgid "«%{group}» is open. Invite people in."
msgstr "«%{group}» открыта. Приглашайте людей."

msgid "Group not approved"
msgstr "Группа не одобрена"

msgid "The box didn't approve «%{group}»."
msgstr "Бокс не одобрил «%{group}»."

msgid "Request to join"
msgstr "Запрос на вступление"

msgid "%{nickname} asks to join «%{group}»."
msgstr "%{nickname} просит вступить в «%{group}»."

msgid "You're in"
msgstr "Вы в группе"

msgid "You joined «%{group}»."
msgstr "Вы вступили в «%{group}»."

msgid "Your group is quiet"
msgstr "В вашей группе тихо"

msgid "Nobody has posted in «%{group}» for a while. Post something or it will be archived."
msgstr "В «%{group}» давно никто не писал. Напишите что-нибудь, иначе она будет архивирована."

msgid "New report"
msgstr "Новая жалоба"

msgid "Someone reported something in the club."
msgstr "Кто-то пожаловался на что-то в клубе."

msgid "A place opened up"
msgstr "Освободилось место"

msgid "You're going to «%{event}» (%{when})."
msgstr "Вы идёте на «%{event}» (%{when})."

msgid "Event cancelled"
msgstr "Событие отменено"

msgid "«%{event}» (%{when}) was cancelled."
msgstr "«%{event}» (%{when}) отменено."

msgid "«%{event}» (%{when}) was cancelled: %{reason}"
msgstr "«%{event}» (%{when}) отменено: %{reason}"

msgid "Event changed"
msgstr "Событие изменено"

msgid "«%{event}» moved to %{when}."
msgstr "«%{event}» перенесено на %{when}."

msgid "«%{event}» has a new place."
msgstr "У «%{event}» новое место."

msgid "«%{event}» has a new time and place: %{when}."
msgstr "У «%{event}» новое время и место: %{when}."

msgid "Starting soon"
msgstr "Скоро начало"

msgid "«%{event}» starts in two hours (%{when})."
msgstr "«%{event}» начнётся через два часа (%{when})."

msgid "Your guest is coming"
msgstr "Ваш гость придёт"

msgid "%{nickname} is coming to «%{event}» with your guest pass."
msgstr "%{nickname} придёт на «%{event}» по вашему гостевому приглашению."

msgid "Try a class"
msgstr "Попробуйте занятие"

msgid "Liked «%{event}»? %{box} invites you to a trial class."
msgstr "Понравилось «%{event}»? %{box} приглашает вас на пробное занятие."

msgid "Message about «%{event}»"
msgstr "Сообщение о «%{event}»"
