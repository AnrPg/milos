msgstr "Новый снимок поможет увидеть твою тенденцию. Это займёт минуту."

msgid "A buddy invitation"
msgstr "Приглашение стать бадди"

msgid "%{nickname} asks you to be their support buddy."
msgstr "%{nickname} просит тебя стать бадди поддержки."

msgid "You have a support buddy"
msgstr "У тебя есть бадди поддержки"

