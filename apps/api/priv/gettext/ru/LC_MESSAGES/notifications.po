msgstr "%{nickname} принял(а) приглашение. Он(а) узнает о тебе, только когда ты попросишь."

msgid "%{nickname} is having a hard moment"
msgstr "%{nickname} переживает трудный момент"

msgid "I'm here · Shall we go for a walk? · Call me"
msgstr "Я здесь · Пойдём прогуляемся? · Позвони мне"

msgid "%{nickname}: Shall we go for a walk?"
msgstr "%{nickname}: Пойдём прогуляемся?"

msgid "%{nickname}: Call me"
msgstr "%{nickname}: Позвони мне"

msgid "%{nickname}: I'm here"
msgstr "%{nickname}: Я здесь"

msgid "%{nickname} replied"
msgstr "%{nickname} ответил(а)"

msgid "No one has replied yet"
msgstr "Пока никто не ответил"

msgid "Until then, something small: two minutes of breathing, a glass of water, a short walk."
msgstr "А пока что-то небольшое: две минуты дыхания, стакан воды, короткая прогулка."

msgid "%{nickname}'s week"
msgstr "Неделя %{nickname}"

msgid "%{moments} hard moments, %{overcome} overcome, %{requests} requests for support."
msgstr "Трудных моментов: %{moments}, преодолено: %{overcome}, просьб о поддержке: %{requests}."

msgid "I'm here"
msgstr "Я здесь"

msgid "Shall we go for a walk?"
msgstr "Пойдём прогуляемся?"

msgid "Call me"
msgstr "Позвони мне"

msgid "How did it go?"
msgstr "Как всё прошло?"

msgid "A quick note on earlier helps you see what works for you."
msgstr "Короткая заметка о недавнем поможет понять, что тебе подходит."

msgid "A glass of water?"
msgstr "Стакан воды?"

msgid "The afternoon is a good moment to catch up on water."
msgstr "День — хорошее время наверстать воду."

msgid "Buddy message"
msgstr "Сообщение от бадди"

msgid "%{nickname}: weekly wellness"
msgstr "%{nickname}: самочувствие за неделю"

msgid "%{sleep} nights at the sleep goal, %{water} days on water, %{meals} days with meals logged."
msgstr "%{sleep} ночей с целью сна, %{water} дней с водой, %{meals} дней с записанными приёмами пищи."

msgid "Garmin stopped syncing"
msgstr "Garmin перестал синхронизироваться"

msgid "Reconnect it from Connected devices to bring your workouts in again."
msgstr "Подключите его снова в разделе «Подключённые устройства», чтобы тренировки снова поступали."

msgid "Your journal export is ready"
msgstr "Экспорт дневника готов"

msgid "Download it within seven days from Settings."
msgstr "Скачайте его в течение семи дней в Настройках."

msgid "Season request"
msgstr "Запрос на сезон"

msgid "%{nickname} asks for a place in %{season}."
msgstr "%{nickname} просит место в %{season}."

msgid "%{nickname} joined the waitlist of %{season}."
msgstr "%{nickname} в листе ожидания на %{season}."

msgid "Your place is confirmed"
msgstr "Твоё место подтверждено"

msgid "%{season} starts on %{date}. The programme is in your Box."
msgstr "%{season} начинается %{date}. Программа в твоём Box."

msgid "Season request not confirmed"
msgstr "Запрос на сезон не подтверждён"

msgid "%{box} could not confirm your place in %{season}."
msgstr "%{box} не смог подтвердить твоё место в %{season}."

msgid "Season cancelled"
msgstr "Сезон отменён"

msgid "%{box} cancelled %{season}."
msgstr "%{box} отменил %{season}."

msgid "You found a training partner"
msgstr "У вас есть партнёр по тренировкам"

msgid "You and %{nickname} both want to train together. Say hi."
msgstr "Вы и %{nickname} хотите тренироваться вместе. Поздоровайтесь."

msgid "Training partner message"
msgstr "Сообщение от партнёра по тренировкам"

msgid "Squad invitation"
msgstr "Приглашение в сквад"

msgid "%{nickname} invited you to the squad «%{group}»."
msgstr "%{nickname} пригласил(а) тебя в сквад «%{group}»."

# ADR-176: a class without its WOD.
msgid "A class has no WOD"
msgstr "У занятия нет WOD"

msgid "%{class} (%{when}) has no WOD, so members can't see or book it. Link one to publish it."
msgstr "У занятия %{class} (%{when}) нет WOD, поэтому участники не видят его и не могут записаться. Привяжите WOD, чтобы опубликовать его."

msgid "%{class} (%{when}) starts in an hour and still has no WOD."
msgstr "Занятие %{class} (%{when}) начнётся через час, а WOD всё ещё нет."

msgid "%{class} (%{when}) has no WOD yet. Link one before it starts."
msgstr "У занятия %{class} (%{when}) ещё нет WOD. Привяжите его до начала."


# ADR-177: a moment on the organiser's clock, then on the reader's when theirs differs.
msgid "%{time} %{zone} · %{local} your time"
msgstr "%{time} %{zone} · %{local} по вашему времени"
