# ADR-176: a class without its WOD.
msgid "A class has no WOD"
msgstr "У занятия нет WOD"

msgid "%{class} (%{when}) has no WOD, so box members can't see or book it. Link one to publish it."
msgstr "У занятия %{class} (%{when}) нет WOD, поэтому участники зала не видят его и не могут записаться. Привяжите WOD, чтобы опубликовать его."

msgid "%{class} (%{when}) starts in an hour and still has no WOD."
msgstr "Занятие %{class} (%{when}) начнётся через час, а WOD всё ещё нет."

msgid "%{class} (%{when}) has no WOD yet. Link one before it starts."
msgstr "У занятия %{class} (%{when}) ещё нет WOD. Привяжите его до начала."


# ADR-179: a moment on the organiser's clock, then on the reader's when theirs differs.
msgid "%{time} %{zone} · %{local} your time"
msgstr "%{time} %{zone} · %{local} по вашему времени"


# ADR-185: co-hosting an event.
msgid "Co-host request"
msgstr "Запрос на совместную организацию"

msgid "%{box} invites you to co-host «%{event}» (%{when})."
msgstr "%{box} приглашает вас стать соорганизатором «%{event}» (%{when})."

