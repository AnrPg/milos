msgid "New booking request"
msgstr "Нова заявка за резервация"

msgid "Booking approved"
msgstr "Резервацията е одобрена"

msgid "Booking rejected"
msgstr "Резервацията е отхвърлена"

msgid "Booking timed out"
msgstr "Времето за изчакване на резервацията изтече"

msgid "Open the schedule to review the latest booking state."
msgstr "Отворете графика, за да прегледате последното състояние на резервацията."

msgid "Workout annotation"
msgstr "Анотация за тренировка"

msgid "A workout annotation needs review."
msgstr "Анотация за тренировка се нуждае от преглед."

msgid "Workout changed"
msgstr "Тренировката е променена"

msgid "Your coach changed a scheduled workout."
msgstr "Вашият треньор промени планираната тренировка."

msgid "Workout removed"
msgstr "Тренировката е премахната"

msgid "Your coach removed a scheduled workout."
msgstr "Вашият треньор премахна планирана тренировка."

msgid "Workout rejected"
msgstr "Тренировката е отхвърлена"

msgid "An athlete"
msgstr "Спортист"

msgid "a workout"
msgstr "тренировка"

msgid "%{nickname} rejected %{title}."
msgstr "%{nickname} отхвърлен %{title}."

msgid "Workout rescheduled"
msgstr "Тренировката е пренасрочена"

msgid "An athlete rescheduled their workout."
msgstr "Спортист пренасрочи тренировката си."

msgid "Message from %{nickname}"
msgstr "Съобщение от %{nickname}"

msgid "%{nickname} sent you a message."
msgstr "%{nickname} ви изпрати съобщение."

msgid "Message from your coach"
msgstr "Съобщение от треньора ви"

msgid "Your coach sent you a message."
msgstr "Треньорът ви изпрати съобщение."

msgid "Message from the box"
msgstr "Съобщение от залата"

msgid "Your gym sent you a message."
msgstr "Залата ви изпрати съобщение."

msgid "Challenge completed"
msgstr "Предизвикателството завършено"

msgid "You completed a challenge."
msgstr "Изпълнихте предизвикателство."

msgid "New message in your workout thread"
msgstr "Ново съобщение в темата за вашата тренировка"

msgid "New message"
msgstr "Ново съобщение"

msgid "You received a new message."
msgstr "Получихте ново съобщение."

msgid "TrainingJournal"
msgstr "Обучение на Милош"

msgid "You have a new notification."
msgstr "Имате ново известие."

msgid "invoice"
msgstr "фактура"

msgid "New invoice"
msgstr "Нова фактура"

msgid "Invoice %{invoice_number} has been issued for your account."
msgstr "За вашия акаунт е издадена фактура %{invoice_number}."

msgid "Payment reminder"
msgstr "Напомняне за плащане"

msgid "You have an outstanding balance of %{amount} due."
msgstr "Имате дължимо салдо от %{amount}."

msgid "Workout assignment requested"
msgstr "Заявено е назначаване на тренировка"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "%{nickname} поиска назначаване на тренировка за %{requested_for}."

msgid "a requested date"
msgstr "заявена дата"

msgid "New review submitted"
msgstr "Изпратен е нов отзив"

msgid "general"
msgstr "общ"

msgid "A %{target_type} review was submitted with a %{rating}/5 rating."
msgstr "Изпратен е отзив за %{target_type} с оценка %{rating}/5."

msgid "A new %{target_type} review needs attention."
msgstr "Нов отзив за %{target_type} изисква внимание."

msgid "Class bookings approved"
msgstr "Одобрени резервации за класове"

msgid "Your coach approved one or more class booking requests."
msgstr "Вашият треньор одобри една или повече заявки за класове."

msgid "New workouts assigned"
msgstr "Зададени са нови тренировки"

msgid "Your coach assigned one or more workouts to you."
msgstr "Вашият треньор ви зададе една или повече тренировки."

msgid "You got a spot"
msgstr "Получи място"

msgid "A place opened up in %{class}. Your booking is confirmed or awaiting approval."
msgstr "Освободи се място в %{class}. Резервацията ти е потвърдена или чака одобрение."

msgid "Your package ends soon"
msgstr "Пакетът ти изтича скоро"

msgid "%{package} ends on %{date}."
msgstr "%{package} изтича на %{date}."

msgid "New form review request"
msgstr "Нова заявка за преглед на техника"

msgid "%{client} sent a video for feedback."
msgstr "%{client} изпрати видео за обратна връзка."

msgid "Your form review is ready"
msgstr "Прегледът на техниката ви е готов"

msgid "Your coach left feedback on your video."
msgstr "Треньорът ви остави обратна връзка за видеото."

msgid "A client is waiting for a reply"
msgstr "Клиент чака отговор"

msgid "%{client} has been waiting longer than the promised reply time."
msgstr "%{client} чака повече от обещаното време за отговор."

msgid "Your nutrition plan was updated"
msgstr "Хранителният ви план е обновен"

msgid "Open it to see what changed."
msgstr "Отворете го, за да видите промените."

msgid "New appointment booked"
msgstr "Нов записан час"

msgid "%{client} booked a session for %{time}."
msgstr "%{client} запази сесия за %{time}."

msgid "Appointment cancelled"
msgstr "Часът е отменен"

msgid "The session on %{time} was cancelled."
msgstr "Сесията на %{time} е отменена."

msgid "A coach took a new athlete"
msgstr "Треньор пое нов атлет"

msgid "%{coach} is now coaching %{client}."
msgstr "%{coach} вече тренира %{client}."

msgid "An admin read your note"
msgstr "Администратор прочете бележката ви"

msgid "%{reader} read your note about %{client} at %{time}."
msgstr "%{reader} прочете бележката ви за %{client} в %{time}."

msgid "A machine needs attention"
msgstr "Уред се нуждае от внимание"

msgid "%{machine}: %{note}"
msgstr "%{machine}: %{note}"

msgid "Reported running low"
msgstr "Съобщено за ниска наличност"

msgid "%{item}: %{note}"
msgstr "%{item}: %{note}"

msgid "Inventory today"
msgstr "Инвентар днес"

msgid "Needs attention: %{items}"
msgstr "Нуждае се от внимание: %{items}"

msgid "Running low"
msgstr "Ниска наличност"

msgid "%{item}: %{quantity} left."
msgstr "%{item}: остават %{quantity}."

msgid "Your subscription ends soon"
msgstr "Абонаментът ви изтича скоро"

msgid "Your subscription has ended"
msgstr "Абонаментът ви изтече"

msgid "your subscription"
msgstr "абонаментът ви"

msgid "%{package} ends on %{date} (in %{days} days). Renew to keep booking classes."
msgstr "%{package} изтича на %{date} (след %{days} дни). Подновете, за да продължите да записвате часове."

msgid "%{package} has ended. You keep access until %{date}; renew before then to keep booking classes."
msgstr "%{package} изтече. Запазвате достъп до %{date}; подновете дотогава, за да продължите да записвате часове."

msgid "Your access has ended"
msgstr "Достъпът ви изтече"

msgid "Your access is paused because a payment is overdue. Pay the outstanding balance to book classes again."
msgstr "Достъпът ви е спрян заради просрочено плащане. Платете дължимото, за да записвате отново часове."

msgid "Your access has ended. Renew your subscription to book classes again."
msgstr "Достъпът ви изтече. Подновете абонамента си, за да записвате отново часове."

msgid "Your upcoming bookings were cancelled: %{count}."
msgstr "Предстоящите ви записвания бяха отменени: %{count}."

msgid "Follow request"
msgstr "Заявка за следване"

msgid "%{nickname} wants to follow you."
msgstr "%{nickname} иска да те следва."

msgid "Follow request accepted"
msgstr "Заявката за следване е приета"

msgid "You now follow %{nickname}."
msgstr "Вече следваш %{nickname}."
