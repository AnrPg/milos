msgstr "Se ha emitido la factura %{invoice_number} para su cuenta."

msgid "Payment reminder"
msgstr "Recordatorio de pago"

msgid "You have an outstanding balance of %{amount} due."
msgstr "Tiene un saldo pendiente de %{amount} adeudado."

