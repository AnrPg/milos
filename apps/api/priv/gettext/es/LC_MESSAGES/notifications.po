msgstr "Asignación de entrenamiento solicitada"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "%{nickname} solicitó una asignación de entrenamiento para el %{requested_for}."

msgid "a requested date"
msgstr "una fecha solicitada"

msgid "New review submitted"
msgstr "Nueva reseña enviada"

msgid "general"
msgstr "general"

msgid "A %{target_type} review was submitted with a %{rating}/5 rating."
msgstr "Se envió una reseña de %{target_type} con una valoración de %{rating}/5."

