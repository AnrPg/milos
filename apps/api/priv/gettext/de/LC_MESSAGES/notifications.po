msgid "New booking request"
msgstr "Neue Buchungsanfrage"

msgid "Booking approved"
msgstr "Buchung genehmigt"

msgid "Booking rejected"
msgstr "Buchung abgelehnt"

msgid "Booking timed out"
msgstr "Zeitüberschreitung bei der Buchung"

msgid "Open the schedule to review the latest booking state."
msgstr "Öffnen Sie den Zeitplan, um den aktuellen Buchungsstatus anzuzeigen."

msgid "Workout annotation"
msgstr "Anmerkung zum Training"

msgid "A workout annotation needs review."
msgstr "Eine Trainingsanmerkung muss überprüft werden."

msgid "Workout changed"
msgstr "Das Training hat sich geändert"

