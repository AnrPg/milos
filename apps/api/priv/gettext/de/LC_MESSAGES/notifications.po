# ADR-176: a class without its WOD.
msgid "A class has no WOD"
msgstr "Eine Stunde hat kein WOD"

msgid "%{class} (%{when}) has no WOD, so members can't see or book it. Link one to publish it."
msgstr "%{class} (%{when}) hat kein WOD, daher können Mitglieder sie weder sehen noch buchen. Verknüpfe eines, um sie zu veröffentlichen."

msgid "%{class} (%{when}) starts in an hour and still has no WOD."
msgstr "%{class} (%{when}) beginnt in einer Stunde und hat noch kein WOD."

msgid "%{class} (%{when}) has no WOD yet. Link one before it starts."
msgstr "%{class} (%{when}) hat noch kein WOD. Verknüpfe eines, bevor sie beginnt."


# ADR-179: a moment on the organiser's clock, then on the reader's when theirs differs.
msgid "%{time} %{zone} · %{local} your time"
msgstr "%{time} %{zone} · %{local} deine Zeit"


# ADR-185: co-hosting an event.
msgid "Co-host request"
msgstr "Anfrage zur Mitveranstaltung"

msgid "%{box} invites you to co-host «%{event}» (%{when})."
msgstr "%{box} lädt euch ein, «%{event}» (%{when}) mitzuveranstalten."

msgid "Co-hosting"
msgstr "Mitveranstaltung"

msgid "%{box} will co-host «%{event}»."
msgstr "%{box} veranstaltet «%{event}» mit."

msgid "%{box} declined to co-host «%{event}»."
msgstr "%{box} hat die Mitveranstaltung von «%{event}» abgelehnt."

msgid "%{box} no longer co-hosts «%{event}»."
msgstr "%{box} veranstaltet «%{event}» nicht mehr mit."

# ADR-187: a password reset request (handlers) and the reset itself (the person).
msgid "Password reset request"
msgstr "Anfrage zum Zurücksetzen des Passworts"

msgid "%{name} (@%{handle}) can't sign in and asked for a password reset."
msgstr "%{name} (@%{handle}) kann sich nicht anmelden und bittet darum, das Passwort zurückzusetzen."

msgid "Your password was reset"
msgstr "Dein Passwort wurde zurückgesetzt"

msgid "Your password was changed with a reset link or a recovery code, and every device was signed out. If this wasn't you, contact your gym or Palee support."
msgstr "Dein Passwort wurde über einen Reset-Link oder einen Wiederherstellungscode geändert, und alle Geräte wurden abgemeldet. Wenn du das nicht warst, wende dich an dein Studio oder den Palee-Support."

msgid "Your demo business is waiting for you"
msgstr "Dein Demo-Unternehmen wartet auf dich"

msgid "Nobody has used %{business} for a while. If nobody opens it in the next %{days} days, its demo data is removed and it is archived. You can reopen it any time."
msgstr "%{business} wurde seit einer Weile nicht genutzt. Wenn es in den nächsten %{days} Tagen niemand öffnet, werden die Demodaten entfernt und es wird archiviert. Du kannst es jederzeit wieder öffnen."

