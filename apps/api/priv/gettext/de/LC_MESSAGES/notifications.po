msgstr "Du hast eine Herausforderung abgeschlossen."

msgid "New message in your workout thread"
msgstr "Neue Nachricht in deinem Trainingsthread"

msgid "New message"
msgstr "Neue Nachricht"

msgid "You received a new message."
msgstr "Sie haben eine neue Nachricht erhalten."

msgid "TrainingJournal"
msgstr "Milos-Training"

msgid "You have a new notification."
msgstr "Sie haben eine neue Benachrichtigung."

msgid "invoice"
msgstr "Rechnung"

msgid "New invoice"
msgstr "Neue Rechnung"

msgid "Invoice %{invoice_number} has been issued for your account."
msgstr "Für Ihr Konto wurde die Rechnung %{invoice_number} ausgestellt."

msgid "Payment reminder"
msgstr "Zahlungserinnerung"

msgid "You have an outstanding balance of %{amount} due."
msgstr "Sie haben einen ausstehenden Betrag von %{amount}."

msgid "Workout assignment requested"
msgstr "Workout-Zuweisung angefragt"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "%{nickname} hat eine Workout-Zuweisung für den %{requested_for} angefragt."

msgid "a requested date"
msgstr "ein gewünschtes Datum"

msgid "New review submitted"
msgstr "Neue Bewertung eingereicht"

msgid "general"
msgstr "allgemein"

