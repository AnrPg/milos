msgid ""
msgstr ""
"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "You're receiving this email because you have a %{product} account."
msgstr "Vous recevez cet e-mail parce que vous avez un compte %{product}."

msgid "You're receiving this email because %{business} sent it to you through %{product}."
msgstr "Vous recevez cet e-mail parce que %{business} vous l’a envoyé via %{product}."

msgid "This email was sent automatically by %{product}."
msgstr "Cet e-mail a été envoyé automatiquement par %{product}."

msgid "If the button doesn't work, copy this link into your browser:"
msgstr "Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :"

msgid "If you didn't ask for this, you can safely ignore this email."
msgstr "Si vous n’êtes pas à l’origine de cette demande, vous pouvez ignorer cet e-mail."

msgid "You're receiving this email because you are the billing contact of %{company} at %{business}."
msgstr "Vous recevez cet e-mail parce que %{business} vous a indiqué comme contact de facturation de %{company}."

msgid "This link works only once."
msgstr "Ce lien ne fonctionne qu’une seule fois."

msgid "Hello %{name},"
msgstr "Bonjour %{name},"

msgid "Hello,"
msgstr "Bonjour,"

# ADR-213: verify_email

msgid "Confirm your email address"
msgstr "Confirmez votre adresse e-mail"

msgid "Please confirm that %{email} is your email address. It lets you get back into your account if you ever forget your password."
msgstr "Veuillez confirmer que %{email} est bien votre adresse e-mail. Vous pourrez ainsi retrouver l’accès à votre compte si vous oubliez un jour votre mot de passe."

msgid "Confirm email"
msgstr "Confirmer l’adresse e-mail"

msgid "This link expires in 48 hours."
msgstr "Ce lien expire dans 48 heures."

msgid "If you didn't create a %{product} account, you can ignore this email."
msgstr "Si vous n’avez pas créé de compte %{product}, vous pouvez ignorer cet e-mail."
msgid "Activate %{business} on %{product}"
msgstr "Activez « %{business} » sur %{product}"
msgid "Your business is ready to go live"
msgstr "Votre entreprise est prête à démarrer"
msgid "The %{product} team approved %{business}. Open the link while signed in to your account to activate it: the demo data is removed and the business goes live."
msgstr "L’équipe %{product} a approuvé « %{business} ». Ouvrez le lien en étant connecté à votre compte pour l’activer : les données de démonstration sont supprimées et l’entreprise est mise en ligne."
msgid "Your role: owner."
msgstr "Votre rôle : propriétaire."
msgid "Your role: admin."
msgstr "Votre rôle : administrateur."
msgid "Activate business"
msgstr "Activer l’entreprise"
msgid "It opens only for your own account."
msgstr "Il ne s’ouvre que pour votre propre compte."
