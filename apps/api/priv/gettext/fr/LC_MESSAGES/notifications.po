msgid "New booking request"
msgstr "Nouvelle demande de réservation"

msgid "Booking approved"
msgstr "Réservation approuvée"

msgid "Booking rejected"
msgstr "Réservation rejetée"

msgid "Booking timed out"
msgstr "La réservation a expiré"

msgid "Open the schedule to review the latest booking state."
msgstr "Ouvrez le planning pour consulter le dernier état de la réservation."

msgid "Workout annotation"
msgstr "Annotation d'entraînement"

msgid "A workout annotation needs review."
msgstr "Une annotation d’entraînement doit être révisée."

msgid "Workout changed"
msgstr "L'entraînement a changé"

msgid "Your coach changed a scheduled workout."
msgstr "Votre entraîneur a modifié un entraînement programmé."

msgid "Workout removed"
msgstr "Entraînement supprimé"

msgid "Your coach removed a scheduled workout."
msgstr "Votre coach a supprimé un entraînement programmé."

msgid "Workout rejected"
msgstr "Entraînement rejeté"

msgid "An athlete"
msgstr "Un athlète"

msgid "a workout"
msgstr "une séance d'entraînement"

msgid "%{nickname} rejected %{title}."
msgstr "%{nickname} a rejeté %{title}."

msgid "Workout rescheduled"
msgstr "Entraînement reporté"

msgid "An athlete rescheduled their workout."
msgstr "Un athlète a reporté son entraînement."

msgid "Message from %{nickname}"
msgstr "Message de %{nickname}"

msgid "%{nickname} sent you a message."
msgstr "%{nickname} vous a envoyé un message."

msgid "New coach note"
msgstr "Nouvelle note du coach"

msgid "Your coach added a new note."
msgstr "Votre coach a ajouté une nouvelle note."

msgid "Challenge completed"
msgstr "Défi terminé"

msgid "You completed a challenge."
msgstr "Vous avez relevé un défi."

msgid "New message in your workout thread"
msgstr "Nouveau message dans votre fil d'entraînement"

msgid "New message"
msgstr "Nouveau message"

msgid "You received a new message."
msgstr "Vous avez reçu un nouveau message."

msgid "TrainingJournal"
msgstr "Formation Milos"

msgid "You have a new notification."
msgstr "Vous avez une nouvelle notification."

msgid "invoice"
msgstr "facture"

msgid "New invoice"
msgstr "Nouvelle facture"

msgid "Invoice %{invoice_number} has been issued for your account."
msgstr "La facture %{invoice_number} a été émise pour votre compte."

msgid "Payment reminder"
msgstr "Rappel de paiement"

msgid "You have an outstanding balance of %{amount} due."
msgstr "Vous avez un solde impayé de %{amount} à payer."

msgid "Workout assignment requested"
msgstr "Affectation d'entraînement demandée"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "%{nickname} a demandé une affectation d'entraînement pour le %{requested_for}."

msgid "a requested date"
msgstr "une date demandée"

msgid "New review submitted"
msgstr "Nouvel avis envoyé"

msgid "general"
msgstr "général"

msgid "A %{target_type} review was submitted with a %{rating}/5 rating."
msgstr "Un avis sur %{target_type} a été envoyé avec une note de %{rating}/5."

msgid "A new %{target_type} review needs attention."
msgstr "Un nouvel avis sur %{target_type} nécessite votre attention."

msgid "Class bookings approved"
msgstr "Réservations de cours approuvées"

msgid "Your coach approved one or more class booking requests."
msgstr "Votre coach a approuvé une ou plusieurs demandes de réservation de cours."

msgid "New workouts assigned"
msgstr "Nouveaux entraînements attribués"

msgid "Your coach assigned one or more workouts to you."
msgstr "Votre coach vous a attribué un ou plusieurs entraînements."

msgid "You got a spot"
msgstr "Une place s’est libérée pour vous"

msgid "A place opened up in %{class}. Your booking is confirmed or awaiting approval."
msgstr "Une place s’est libérée dans %{class}. Votre réservation est confirmée ou en attente de validation."

msgid "Your package ends soon"
msgstr "Votre forfait se termine bientôt"

msgid "%{package} ends on %{date}."
msgstr "%{package} se termine le %{date}."

msgid "New form review request"
msgstr "Nouvelle demande d'analyse technique"

msgid "%{client} sent a video for feedback."
msgstr "%{client} a envoyé une vidéo pour un retour."

msgid "Your form review is ready"
msgstr "Votre analyse technique est prête"

msgid "Your coach left feedback on your video."
msgstr "Votre coach a laissé un retour sur votre vidéo."

msgid "A client is waiting for a reply"
msgstr "Un client attend une réponse"

msgid "%{client} has been waiting longer than the promised reply time."
msgstr "%{client} attend depuis plus longtemps que le délai de réponse promis."

msgid "Your nutrition plan was updated"
msgstr "Votre plan nutritionnel a été mis à jour"

msgid "Open it to see what changed."
msgstr "Ouvrez-le pour voir ce qui a changé."

msgid "New appointment booked"
msgstr "Nouveau rendez-vous réservé"

msgid "%{client} booked a session for %{time}."
msgstr "%{client} a réservé une séance pour %{time}."

msgid "Appointment cancelled"
msgstr "Rendez-vous annulé"

msgid "The session on %{time} was cancelled."
msgstr "La séance du %{time} a été annulée."

msgid "A coach took a new athlete"
msgstr "Un coach a pris en charge un nouvel athlète"

msgid "%{coach} is now coaching %{client}."
msgstr "%{coach} entraîne désormais %{client}."

msgid "An admin read your note"
msgstr "Un administrateur a lu votre note"

msgid "%{reader} read your note about %{client} at %{time}."
msgstr "%{reader} a lu votre note sur %{client} à %{time}."

msgid "A machine needs attention"
msgstr "Une machine nécessite une intervention"

msgid "%{machine}: %{note}"
msgstr "%{machine}: %{note}"

msgid "Reported running low"
msgstr "Signalé en rupture proche"

msgid "%{item}: %{note}"
msgstr "%{item} : %{note}"

msgid "Inventory today"
msgstr "Inventaire du jour"

msgid "Needs attention: %{items}"
msgstr "À surveiller : %{items}"

msgid "Running low"
msgstr "Stock faible"

msgid "%{item}: %{quantity} left."
msgstr "%{item} : plus que %{quantity}."

msgid "Your subscription ends soon"
msgstr "Votre abonnement se termine bientôt"

msgid "Your subscription has ended"
msgstr "Votre abonnement est terminé"

msgid "your subscription"
msgstr "votre abonnement"

msgid "%{package} ends on %{date} (in %{days} days). Renew to keep booking classes."
msgstr "%{package} se termine le %{date} (dans %{days} jours). Renouvelez pour continuer à réserver des cours."

msgid "%{package} has ended. You keep access until %{date}; renew before then to keep booking classes."
msgstr "%{package} est terminé. Vous gardez l'accès jusqu'au %{date} ; renouvelez d'ici là pour continuer à réserver des cours."

msgid "Your access has ended"
msgstr "Votre accès est terminé"

msgid "Your access is paused because a payment is overdue. Pay the outstanding balance to book classes again."
msgstr "Votre accès est suspendu car un paiement est en retard. Réglez le solde dû pour réserver à nouveau des cours."

msgid "Your access has ended. Renew your subscription to book classes again."
msgstr "Votre accès est terminé. Renouvelez votre abonnement pour réserver à nouveau des cours."

msgid "Your upcoming bookings were cancelled: %{count}."
msgstr "Vos prochaines réservations ont été annulées : %{count}."
