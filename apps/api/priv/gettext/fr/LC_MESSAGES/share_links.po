"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "%{name} invited you to an event"
msgstr "Invitation de %{name} à un événement"

msgid "%{name} asked you to be their check-in buddy"
msgstr "Invitation de %{name} à devenir son binôme de soutien"

msgid "%{name} invited you to train together"
msgstr "Invitation de %{name} à s'entraîner ensemble"

msgid "Open the invitation"
msgstr "Ouvrir l'invitation"

msgid "%{name} invited you to an event on %{product} as their guest. Open the invitation to see it and say if you're coming."
msgstr "Vous avez reçu une invitation de %{name} à un événement sur %{product}, en tant qu'invité. Ouvrez l'invitation pour le découvrir et dire si vous venez."

msgid "%{name} asked you to be their check-in buddy on %{product}: someone they can turn to for support."
msgstr "Vous avez reçu une invitation de %{name} à devenir son binôme de soutien sur %{product} : une personne vers qui se tourner pour être soutenu."

msgid "%{name} invited you to train together on %{product}."
msgstr "Vous avez reçu une invitation de %{name} à s'entraîner ensemble sur %{product}."

msgid "%{name} typed in your address to send you this link. If you don't know them, ignore this email."
msgstr "%{name} a saisi votre adresse pour vous envoyer ce lien. Si vous ne connaissez pas cette personne, ignorez cet e-mail."

msgid "You're receiving this email because %{name} sent you an invitation through %{product}."
msgstr "Vous recevez cet e-mail parce que %{name} vous a envoyé une invitation via %{product}."
