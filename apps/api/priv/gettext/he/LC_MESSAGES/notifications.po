msgid "Reconnect it from Connected devices to bring your workouts in again."
msgstr "חברו אותו מחדש ממכשירים מחוברים כדי שהאימונים יגיעו שוב."

msgid "Your journal export is ready"
msgstr "ייצוא היומן שלך מוכן"

msgid "Download it within seven days from Settings."
msgstr "הורד אותו תוך שבעה ימים מההגדרות."

msgid "Season request"
msgstr "בקשה לעונה"

msgid "%{nickname} asks for a place in %{season}."
msgstr "%{nickname} מבקש/ת מקום ב-%{season}."

msgid "%{nickname} joined the waitlist of %{season}."
msgstr "%{nickname} ברשימת ההמתנה ל-%{season}."

msgid "Your place is confirmed"
msgstr "המקום שלך אושר"

msgid "%{season} starts on %{date}. The programme is in your Box."
msgstr "%{season} מתחילה ב-%{date}. התוכנית נמצאת ב-Box שלך."

msgid "Season request not confirmed"
msgstr "הבקשה לעונה לא אושרה"

msgid "%{box} could not confirm your place in %{season}."
msgstr "%{box} לא יכול/ה לאשר את מקומך ב-%{season}."

msgid "Season cancelled"
msgstr "העונה בוטלה"

msgid "%{box} cancelled %{season}."
msgstr "%{box} ביטל/ה את %{season}."

msgid "You found a training partner"
msgstr "מצאת שותף לאימונים"

msgid "You and %{nickname} both want to train together. Say hi."
msgstr "את/ה ו-%{nickname} רוצים להתאמן יחד. תגידו שלום."

msgid "Training partner message"
msgstr "הודעה משותף לאימונים"

msgid "PT squad invitation"
msgstr "הזמנה לסקוואד PT"

msgid "%{nickname} invited you to the PT squad «%{group}»."
msgstr "%{nickname} הזמין/ה אותך לסקוואד PT «%{group}»."

# ADR-176: a class without its WOD.
msgid "A class has no WOD"
msgstr "לשיעור אין WOD"

msgid "%{class} (%{when}) has no WOD, so box members can't see or book it. Link one to publish it."
msgstr "ל־%{class} (%{when}) אין WOD, ולכן חברי המכון לא רואים אותו ולא יכולים להירשם. קשרו WOD כדי לפרסם אותו."

msgid "%{class} (%{when}) starts in an hour and still has no WOD."
msgstr "%{class} (%{when}) מתחיל בעוד שעה ועדיין אין לו WOD."

msgid "%{class} (%{when}) has no WOD yet. Link one before it starts."
msgstr "ל־%{class} (%{when}) עדיין אין WOD. קשרו WOD לפני שהוא מתחיל."


# ADR-179: a moment on the organiser's clock, then on the reader's when theirs differs.
msgid "%{time} %{zone} · %{local} your time"
msgstr "%{time} %{zone} · %{local} לפי השעה שלך"


# ADR-185: co-hosting an event.
msgid "Co-host request"
msgstr "בקשה לאירוח משותף"

msgid "%{box} invites you to co-host «%{event}» (%{when})."
msgstr "%{box} מזמין אותך לארח במשותף את «%{event}» (%{when})."

msgid "Co-hosting"
msgstr "אירוח משותף"

msgid "%{box} will co-host «%{event}»."
msgstr "%{box} יארח במשותף את «%{event}»."

msgid "%{box} declined to co-host «%{event}»."
msgstr "%{box} דחה את האירוח המשותף של «%{event}»."

msgid "%{box} no longer co-hosts «%{event}»."
msgstr "%{box} כבר לא מארח במשותף את «%{event}»."

# ADR-187: a password reset request (handlers) and the reset itself (the person).
msgid "Password reset request"
msgstr "בקשה לאיפוס סיסמה"

msgid "%{name} (@%{handle}) can't sign in and asked for a password reset."
msgstr "%{name} (@%{handle}) לא מצליח/ה להתחבר וביקש/ה לאפס את הסיסמה."

msgid "Your password was reset"
msgstr "הסיסמה שלך אופסה"

msgid "Your password was changed with a reset link or a recovery code, and every device was signed out. If this wasn't you, contact your box or Palee support."
msgstr "הסיסמה שלך שונתה באמצעות קישור איפוס או קוד שחזור, וכל המכשירים נותקו מהחשבון. אם זה לא היית את/ה, פנה/י למכון שלך או לתמיכה של Palee."

msgid "Your demo business is waiting for you"
msgstr "העסק לדוגמה שלך מחכה לך"

msgid "Nobody has used %{business} for a while. If nobody opens it in the next %{days} days, its demo data is removed and it is archived. You can reopen it any time."
msgstr "אף אחד לא השתמש ב-%{business} כבר זמן מה. אם אף אחד לא יפתח אותו ב-%{days} הימים הקרובים, נתוני הדוגמה שלו יימחקו והוא יועבר לארכיון. אפשר לפתוח אותו מחדש בכל עת."

msgid "Shop stock running low"
msgstr "המלאי בחנות עומד להיגמר"

msgid "New shop order"
msgstr "הזמנה חדשה בחנות"

msgid "Order #%{number} is waiting to be prepared."
msgstr "הזמנה #%{number} ממתינה להכנה."

msgid "Your order is ready"
msgstr "ההזמנה שלך מוכנה"

msgid "Order #%{number} is ready for pickup."
msgstr "הזמנה #%{number} מוכנה לאיסוף."

msgid "Your order is waiting for you"
msgstr "ההזמנה שלך מחכה לך"

msgid "Order #%{number} is ready for pickup. Your code: %{code}."
msgstr "הזמנה #%{number} מוכנה לאיסוף. הקוד שלך: %{code}."

msgid "Your order was cancelled"
msgstr "ההזמנה שלך בוטלה"

msgid "Order #%{number} was cancelled and nothing was charged."
msgstr "הזמנה #%{number} בוטלה ולא בוצע חיוב."

msgid "Back in stock"
msgstr "שוב במלאי"

msgid "%{item} is available again."
msgstr "%{item} שוב זמין."

msgid "New follower"
msgstr "עוקב חדש"

msgid "%{nickname} started following you."
msgstr "%{nickname} התחיל לעקוב אחריך."

msgid "Message request"
msgstr "בקשת הודעה"

msgid "%{nickname} wants to send you a message."
msgstr "%{nickname} רוצה לשלוח לך הודעה."

msgid "Class cancelled"
msgstr "השיעור בוטל"

msgid "%{class} (%{time}) was cancelled: %{reason}. Your place was released."
msgstr "השיעור %{class} (%{time}) בוטל: %{reason}. המקום שלך שוחרר."

msgid "%{class} (%{time}) was cancelled. Your place was released."
msgstr "השיעור %{class} (%{time}) בוטל. המקום שלך שוחרר."

msgid "The email key expires soon"
msgstr "מפתח המייל יפוג בקרוב"

msgid "Palee's SMTP key expires in %{days} days (%{date}). Create a new key in Brevo and update the server's secret before then, or Palee stops sending email."
msgstr "מפתח ה-SMTP של Palee יפוג בעוד %{days} ימים (%{date}). צרו מפתח חדש ב-Brevo ועדכנו את הסוד בשרת לפני כן, אחרת Palee יפסיק לשלוח מיילים."

msgid "Palee's SMTP key expired on %{date}, so Palee can't send email. Create a new key in Brevo and update the server's secret."
msgstr "מפתח ה-SMTP של Palee פג ב-%{date}, ולכן Palee לא יכול לשלוח מיילים. צרו מפתח חדש ב-Brevo ועדכנו את הסוד בשרת."

msgid "The email key has expired"
msgstr "מפתח המייל פג"
