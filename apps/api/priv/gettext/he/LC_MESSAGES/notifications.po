msgid "New booking request"
msgstr "בקשת הזמנה חדשה"

msgid "Booking approved"
msgstr "ההזמנה אושרה"

msgid "Booking rejected"
msgstr "ההזמנה נדחתה"

msgid "Booking timed out"
msgstr "תם הזמן הקצוב להזמנה"

msgid "Open the schedule to review the latest booking state."
msgstr "פתח את לוח הזמנים כדי לבדוק את מצב ההזמנה האחרון."

msgid "Workout annotation"
msgstr "הערת אימון"

msgid "A workout annotation needs review."
msgstr "הערת אימון דורשת בדיקה."

msgid "Workout changed"
msgstr "האימון השתנה"

msgid "Your coach changed a scheduled workout."
msgstr "המאמן שלך שינה אימון מתוכנן."

msgid "Workout removed"
msgstr "האימון הוסר"

msgid "Your coach removed a scheduled workout."
msgstr "המאמן שלך הסיר אימון מתוזמן."

msgid "Workout rejected"
msgstr "האימון נדחה"

msgid "An athlete"
msgstr "ספורטאי"

msgid "a workout"
msgstr "אימון"

msgid "%{nickname} rejected %{title}."
msgstr "%{nickname} דחה את %{title}."

msgid "Workout rescheduled"
msgstr "האימון נקבע מחדש"

msgid "An athlete rescheduled their workout."
msgstr "ספורטאי קבע מחדש את האימון שלו."

msgid "Message from %{nickname}"
msgstr "הודעה מאת %{nickname}"

msgid "%{nickname} sent you a message."
msgstr "%{nickname} שלח לך הודעה."

msgid "Message from your coach"
msgstr "הודעה מהמאמן שלך"

msgid "Your coach sent you a message."
msgstr "המאמן שלך שלח לך הודעה."

msgid "Message from the box"
msgstr "הודעה מהמכון"

msgid "Your gym sent you a message."
msgstr "המכון שלך שלח לך הודעה."

msgid "Challenge completed"
msgstr "האתגר הושלם"

msgid "You completed a challenge."
msgstr "השלמת אתגר."

msgid "New message in your workout thread"
msgstr "הודעה חדשה בשרשור האימון שלך"

msgid "New message"
msgstr "הודעה חדשה"

msgid "You received a new message."
msgstr "קיבלת הודעה חדשה."

msgid "TrainingJournal"
msgstr "אימון מילוס"

msgid "You have a new notification."
msgstr "יש לך הודעה חדשה."

msgid "invoice"
msgstr "חֶשׁבּוֹנִית"

msgid "New invoice"
msgstr "חשבונית חדשה"

msgid "Invoice %{invoice_number} has been issued for your account."
msgstr "חשבונית %{invoice_number} הונפקה עבור חשבונך."

msgid "Payment reminder"
msgstr "תזכורת לתשלום"

msgid "You have an outstanding balance of %{amount} due."
msgstr "יש לך יתרת חוב של %{amount} לפירעון."

msgid "Workout assignment requested"
msgstr "התבקשה הקצאת אימון"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "%{nickname} ביקש/ה הקצאת אימון לתאריך %{requested_for}."

msgid "a requested date"
msgstr "תאריך מבוקש"

msgid "New review submitted"
msgstr "נשלחה ביקורת חדשה"

msgid "general"
msgstr "כללי"

msgid "A %{target_type} review was submitted with a %{rating}/5 rating."
msgstr "נשלחה ביקורת מסוג %{target_type} עם דירוג %{rating}/5."

msgid "A new %{target_type} review needs attention."
msgstr "ביקורת חדשה מסוג %{target_type} דורשת התייחסות."

msgid "Class bookings approved"
msgstr "הזמנות לשיעורים אושרו"

msgid "Your coach approved one or more class booking requests."
msgstr "המאמן שלך אישר בקשה אחת או יותר להזמנת שיעורים."

msgid "New workouts assigned"
msgstr "הוקצו אימונים חדשים"

msgid "Your coach assigned one or more workouts to you."
msgstr "המאמן שלך הקצה לך אימון אחד או יותר."

msgid "You got a spot"
msgstr "התפנה לך מקום"

msgid "A place opened up in %{class}. Your booking is confirmed or awaiting approval."
msgstr "התפנה מקום ב-%{class}. ההזמנה אושרה או ממתינה לאישור."

msgid "Your package ends soon"
msgstr "החבילה מסתיימת בקרוב"

msgid "%{package} ends on %{date}."
msgstr "%{package} מסתיימת ב-%{date}."

msgid "New form review request"
msgstr "בקשה חדשה לבדיקת טכניקה"

msgid "%{client} sent a video for feedback."
msgstr "%{client} שלח/ה סרטון לקבלת משוב."

msgid "Your form review is ready"
msgstr "בדיקת הטכניקה שלך מוכנה"

msgid "Your coach left feedback on your video."
msgstr "המאמן השאיר משוב על הסרטון שלך."

msgid "A client is waiting for a reply"
msgstr "לקוח מחכה לתשובה"

msgid "%{client} has been waiting longer than the promised reply time."
msgstr "%{client} מחכה יותר מזמן התגובה שהובטח."

msgid "Your nutrition plan was updated"
msgstr "תוכנית התזונה שלך עודכנה"

msgid "Open it to see what changed."
msgstr "פתח/י כדי לראות מה השתנה."

msgid "New appointment booked"
msgstr "נקבעה פגישה חדשה"

msgid "%{client} booked a session for %{time}."
msgstr "%{client} קבע/ה מפגש ל-%{time}."

msgid "Appointment cancelled"
msgstr "הפגישה בוטלה"

msgid "The session on %{time} was cancelled."
msgstr "המפגש ב-%{time} בוטל."

msgid "A coach took a new athlete"
msgstr "מאמן לקח אתלט חדש"

msgid "%{coach} is now coaching %{client}."
msgstr "%{coach} מאמן/ת כעת את %{client}."

msgid "An admin read your note"
msgstr "מנהל קרא את ההערה שלך"

msgid "%{reader} read your note about %{client} at %{time}."
msgstr "%{reader} קרא/ה את ההערה שלך על %{client} ב-%{time}."

msgid "A machine needs attention"
msgstr "מכשיר דורש תשומת לב"

msgid "%{machine}: %{note}"
msgstr "%{machine}: %{note}"

msgid "Reported running low"
msgstr "דווח על מלאי נמוך"

msgid "%{item}: %{note}"
msgstr "%{item}: %{note}"

msgid "Inventory today"
msgstr "המלאי היום"

msgid "Needs attention: %{items}"
msgstr "דורש תשומת לב: %{items}"

msgid "Running low"
msgstr "מלאי נמוך"

msgid "%{item}: %{quantity} left."
msgstr "%{item}: נותרו %{quantity}."

msgid "Your subscription ends soon"
msgstr "המנוי שלך מסתיים בקרוב"

msgid "Your subscription has ended"
msgstr "המנוי שלך הסתיים"

msgid "your subscription"
msgstr "המנוי שלך"

msgid "%{package} ends on %{date} (in %{days} days). Renew to keep booking classes."
msgstr "%{package} מסתיים ב־%{date} (בעוד %{days} ימים). חדשו כדי להמשיך להזמין שיעורים."

msgid "%{package} has ended. You keep access until %{date}; renew before then to keep booking classes."
msgstr "%{package} הסתיים. הגישה נשמרת עד %{date}; חדשו עד אז כדי להמשיך להזמין שיעורים."

msgid "Your access has ended"
msgstr "הגישה שלך הסתיימה"

msgid "Your access is paused because a payment is overdue. Pay the outstanding balance to book classes again."
msgstr "הגישה שלך מושהית בגלל תשלום באיחור. שלמו את היתרה כדי להזמין שיעורים שוב."

msgid "Your access has ended. Renew your subscription to book classes again."
msgstr "הגישה שלך הסתיימה. חדשו את המנוי כדי להזמין שיעורים שוב."

msgid "Your upcoming bookings were cancelled: %{count}."
msgstr "ההזמנות הקרובות שלך בוטלו: %{count}."

msgid "Follow request"
msgstr "בקשת מעקב"

msgid "%{nickname} wants to follow you."
msgstr "%{nickname} רוצה לעקוב אחריך."

msgid "Follow request accepted"
msgstr "בקשת המעקב התקבלה"

msgid "You now follow %{nickname}."
msgstr "עכשיו אתה עוקב אחרי %{nickname}."
