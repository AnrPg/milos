msgid "You're receiving this email because you have a %{product} account."
msgstr "קיבלתם את המייל הזה כי יש לכם חשבון ב-%{product}."

msgid "You're receiving this email because %{business} sent it to you through %{product}."
msgstr "קיבלתם את המייל הזה מ-%{business} דרך %{product}."

msgid "This email was sent automatically by %{product}."
msgstr "המייל הזה נשלח אוטומטית על ידי %{product}."

msgid "If the button doesn't work, copy this link into your browser:"
msgstr "אם הכפתור לא עובד, העתיקו את הקישור הזה לדפדפן:"

msgid "If you didn't ask for this, you can safely ignore this email."
msgstr "אם לא ביקשתם זאת, אפשר פשוט להתעלם מהמייל הזה."

msgid "You're receiving this email because you are the billing contact of %{company} at %{business}."
msgstr "קיבלתם את המייל הזה כי %{business} רשם אתכם כאנשי הקשר לחשבוניות של %{company}."

msgid "This link works only once."
msgstr "הקישור הזה עובד פעם אחת בלבד."

msgid "Hello %{name},"
msgstr "שלום %{name},"

msgid "Hello,"
msgstr "שלום,"

msgid "Reset your %{product} password"
msgstr "איפוס הסיסמה ל-%{product}"

msgid "Reset your password"
msgstr "איפוס הסיסמה"

msgid "Someone asked to reset the password of your %{product} account. To choose a new password, use the button below."
msgstr "התקבלה בקשה לאפס את הסיסמה של החשבון שלך ב-%{product}. כדי לבחור סיסמה חדשה, יש ללחוץ על הכפתור למטה."

msgid "Choose a new password"
msgstr "בחירת סיסמה חדשה"

msgid "This link works for 1 hour."
msgstr "הקישור תקף למשך שעה אחת."

msgid "Setting a new password signs you out on every device."
msgstr "הגדרת סיסמה חדשה מנתקת אותך מכל המכשירים."

msgid "Your password has not been changed."
msgstr "הסיסמה שלך לא שונתה."
