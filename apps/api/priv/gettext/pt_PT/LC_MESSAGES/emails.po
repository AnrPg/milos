msgid ""
msgstr ""
"Language: pt_PT\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "You're receiving this email because you have a %{product} account."
msgstr "Está a receber este email porque tem uma conta no %{product}."

msgid "You're receiving this email because %{business} sent it to you through %{product}."
msgstr "Está a receber este email porque %{business} lho enviou através do %{product}."

msgid "This email was sent automatically by %{product}."
msgstr "Este email foi enviado automaticamente pelo %{product}."

msgid "If the button doesn't work, copy this link into your browser:"
msgstr "Se o botão não funcionar, copie esta ligação para o seu navegador:"

msgid "If you didn't ask for this, you can safely ignore this email."
msgstr "Se não fez este pedido, pode simplesmente ignorar este email."

msgid "You're receiving this email because you are the billing contact of %{company} at %{business}."
msgstr "Está a receber este email porque %{business} o indicou como contacto de faturação de %{company}."

msgid "This link works only once."
msgstr "Esta ligação só funciona uma vez."

msgid "Hello %{name},"
msgstr "Olá %{name},"

msgid "Hello,"
msgstr "Olá,"

# ADR-213: verify_email

msgid "Confirm your email address"
msgstr "Confirme o seu endereço de email"

msgid "Please confirm that %{email} is your email address. It lets you get back into your account if you ever forget your password."
msgstr "Confirme que %{email} é o seu endereço de email. Assim poderá voltar a entrar na sua conta se algum dia se esquecer da palavra-passe."

msgid "Confirm email"
msgstr "Confirmar email"

msgid "This link expires in 48 hours."
msgstr "Esta ligação expira dentro de 48 horas."

msgid "If you didn't create a %{product} account, you can ignore this email."
msgstr "Se não criou uma conta no %{product}, pode simplesmente ignorar este email."
msgid "Activate %{business} on %{product}"
msgstr "Ative «%{business}» no %{product}"
msgid "Your business is ready to go live"
msgstr "O seu negócio está pronto para começar"
msgid "The %{product} team approved %{business}. Open the link while signed in to your account to activate it: the demo data is removed and the business goes live."
msgstr "A equipa do %{product} aprovou «%{business}». Abra a ligação com sessão iniciada na sua conta para o ativar: os dados de demonstração são removidos e o negócio entra em funcionamento."
msgid "Your role: owner."
msgstr "A sua função: proprietário."
msgid "Your role: admin."
msgstr "A sua função: administrador."
msgid "Activate business"
msgstr "Ativar negócio"
msgid "It opens only for your own account."
msgstr "Só abre para a sua própria conta."
# ADR-208: security notices
msgid "You're receiving this security notice because it concerns your %{product} account. Security notices can't be turned off."
msgstr "Está a receber este aviso de segurança porque diz respeito à sua conta no %{product}. Os avisos de segurança não podem ser desativados."
msgid "%{product} app"
msgstr "App %{product}"
msgid "%{product} app on %{platform}"
msgstr "App %{product} em %{platform}"
msgid "%{client} on %{platform}"
msgstr "%{client} em %{platform}"
msgid "Your password was changed"
msgstr "A sua palavra-passe foi alterada"
msgid "The password of your %{product} account was changed in Settings."
msgstr "A palavra-passe da sua conta no %{product} foi alterada nas Definições."
msgid "Your password was reset"
msgstr "A sua palavra-passe foi reposta"
msgid "The password of your %{product} account was reset, and every device was signed out."
msgstr "A palavra-passe da sua conta no %{product} foi reposta e todos os dispositivos terminaram a sessão."
msgid "Someone signed in to your %{product} account asked to change its email address to %{email}. Nothing changes until the new address is confirmed."
msgstr "Alguém com sessão iniciada na sua conta no %{product} pediu para alterar o endereço de email para %{email}. Nada muda até o novo endereço ser confirmado."
msgid "Someone signed in to your %{product} account asked to change its email address. Nothing changes until the new address is confirmed."
msgstr "Alguém com sessão iniciada na sua conta no %{product} pediu para alterar o endereço de email. Nada muda até o novo endereço ser confirmado."
msgid "A change of your email address was requested"
msgstr "Foi pedida a alteração do seu endereço de email"
msgid "The email address of your %{product} account was changed to %{email}. Emails about your account now go there."
msgstr "O endereço de email da sua conta no %{product} foi alterado para %{email}. Os emails sobre a sua conta passam a ir para lá."
msgid "The email address of your %{product} account was changed. Emails about your account now go to the new address."
msgstr "O endereço de email da sua conta no %{product} foi alterado. Os emails sobre a sua conta passam a ir para o novo endereço."
msgid "Your email address was changed"
msgstr "O seu endereço de email foi alterado"
msgid "If this was you, there's nothing else to do."
msgstr "Se foi o próprio, não precisa de fazer mais nada."
msgid "If this wasn't you, undo the change right away. Then sign out everywhere and choose a new password."
msgstr "Se não foi o próprio, anule já a alteração. Depois termine a sessão em todo o lado e escolha uma nova palavra-passe."
msgid "Undo this change"
msgstr "Anular esta alteração"
msgid "A recovery code was used"
msgstr "Foi usado um código de recuperação"
msgid "One of your recovery codes was used to set a new password for your %{product} account, and every device was signed out."
msgstr "Um dos seus códigos de recuperação foi usado para definir uma nova palavra-passe na sua conta no %{product}, e todos os dispositivos terminaram a sessão."
msgid "New recovery codes were created"
msgstr "Foram criados novos códigos de recuperação"
msgid "New recovery codes were created for your %{product} account. The old codes no longer work."
msgstr "Foram criados novos códigos de recuperação para a sua conta no %{product}. Os códigos antigos deixaram de funcionar."
msgid "You have no unused recovery codes left."
msgstr "Já não tem nenhum código de recuperação por usar."
msgid "You have only one unused recovery code left."
msgstr "Resta-lhe apenas um código de recuperação por usar."
msgid "You have only two unused recovery codes left."
msgstr "Restam-lhe apenas dois códigos de recuperação por usar."
msgid "You're running out of recovery codes"
msgstr "Os seus códigos de recuperação estão a acabar"
msgid "Create new codes in Settings and keep them somewhere safe, so you can always get back into your account."
msgstr "Crie novos códigos nas Definições e guarde-os num local seguro, para poder voltar sempre à sua conta."
msgid "Open Settings"
msgstr "Abrir Definições"
msgid "You were signed out everywhere"
msgstr "A sessão foi terminada em todo o lado"
msgid "Every device signed in to your %{product} account was signed out."
msgstr "Todos os dispositivos com sessão iniciada na sua conta no %{product} terminaram a sessão."
msgid "If this wasn't you, choose a new password right away."
msgstr "Se não foi o próprio, escolha já uma nova palavra-passe."
msgid "Choose a new password"
msgstr "Escolher uma nova palavra-passe"
msgid "A new profile was added to your %{product} account: %{profile}."
msgstr "Foi adicionado um novo perfil à sua conta no %{product}: %{profile}."
msgid "A new profile was added to your %{product} account."
msgstr "Foi adicionado um novo perfil à sua conta no %{product}."
msgid "A profile was added to your account"
msgstr "Foi adicionado um perfil à sua conta"
msgid "New sign-in to your account"
msgstr "Novo início de sessão na sua conta"
msgid "Your %{product} account was just used to sign in on a device it hasn't been used on before."
msgstr "A sua conta no %{product} acabou de ser usada para iniciar sessão num dispositivo onde nunca tinha sido usada."
msgid "Your profile will be deleted"
msgstr "O seu perfil vai ser eliminado"
msgid "Your profile %{profile} on %{product} will be deleted on %{date}."
msgstr "O seu perfil %{profile} no %{product} será eliminado a %{date}."
msgid "Your account will be deleted"
msgstr "A sua conta vai ser eliminada"
msgid "Your %{product} account and all its profiles will be deleted on %{date}."
msgstr "A sua conta no %{product} e todos os seus perfis serão eliminados a %{date}."
msgid "Changed your mind? You can undo it until then."
msgstr "Mudou de ideias? Pode anular até lá."
msgid "If this wasn't you, undo the deletion right away. Then sign out everywhere and choose a new password."
msgstr "Se não foi o próprio, anule já a eliminação. Depois termine a sessão em todo o lado e escolha uma nova palavra-passe."
msgid "Undo the deletion"
msgstr "Anular a eliminação"
msgid "Your profile was deleted"
msgstr "O seu perfil foi eliminado"
msgid "Your profile %{profile} on %{product} was deleted, as you asked."
msgstr "O seu perfil %{profile} no %{product} foi eliminado, como pediu."
msgid "Your account was deleted"
msgstr "A sua conta foi eliminada"
msgid "Your %{product} account and all its profiles were deleted, as you asked."
msgstr "A sua conta no %{product} e todos os seus perfis foram eliminados, como pediu."
msgid "If this wasn't you, sign out everywhere right away, then choose a new password."
msgstr "Se não foi o próprio, termine já a sessão em todo o lado e depois escolha uma nova palavra-passe."
msgid "Sign out everywhere"
msgstr "Terminar sessão em todo o lado"
msgid "The sign-out link signs out every device, including this one, and works for 7 days."
msgstr "A ligação termina a sessão em todos os dispositivos, incluindo este, e funciona durante 7 dias."
msgid "When"
msgstr "Quando"
msgid "Device"
msgstr "Dispositivo"
msgid "Location"
msgstr "Localização"
msgid "IP address"
msgstr "Endereço IP"
msgid "Reset your %{product} password"
msgstr "Repor a palavra-passe do %{product}"
msgid "Reset your password"
msgstr "Repor a palavra-passe"
msgid "Someone asked to reset the password of your %{product} account. To choose a new password, use the button below."
msgstr "Foi pedida a reposição da palavra-passe da sua conta %{product}. Para escolher uma nova palavra-passe, utilize o botão abaixo."
msgid "This link works for 1 hour."
msgstr "Esta ligação é válida durante 1 hora."
msgid "Setting a new password signs you out on every device."
msgstr "Ao definir uma nova palavra-passe, termina a sessão em todos os dispositivos."
msgid "Your password has not been changed."
msgstr "A sua palavra-passe não foi alterada."
msgid "Unsubscribe from these emails"
msgstr "Cancelar a subscrição destes emails"
msgid "You will no longer receive this kind of email from %{product}. Emails about your account and its security still arrive."
msgstr "Deixará de receber este tipo de email do %{product}. Os emails sobre a sua conta e a respetiva segurança continuarão a chegar."
msgid "You're unsubscribed"
msgstr "Subscrição cancelada"
msgid "This unsubscribe link is not valid."
msgstr "Esta ligação para cancelar a subscrição não é válida."



msgid "Confirm your new email address"
msgstr "Confirme o seu novo endereço de email"

msgid "Someone asked to make this the sign-in address of a %{product} account. Confirm it to finish the change. Until then, the account keeps its current address."
msgstr "Foi pedido que este endereço passe a ser o endereço de início de sessão de uma conta %{product}. Confirme-o para concluir a alteração. Até lá, a conta mantém o endereço atual."

msgid "Confirm this address"
msgstr "Confirmar este endereço"

msgid "The link works for 24 hours."
msgstr "A ligação é válida durante 24 horas."

msgid "You're receiving this email because someone asked to use this address for a %{product} account."
msgstr "Está a receber este email porque foi pedido que este endereço fosse usado numa conta %{product}."
