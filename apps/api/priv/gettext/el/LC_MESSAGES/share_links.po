msgid ""
msgstr ""
"Language: el\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "%{name} invited you to an event"
msgstr "Πρόσκληση από %{name} σε εκδήλωση"

msgid "%{name} asked you to be their check-in buddy"
msgstr "Πρόσκληση από %{name} να γίνετε φιλαράκι στήριξης"

msgid "%{name} invited you to train together"
msgstr "Πρόσκληση από %{name} για κοινή προπόνηση"

msgid "Open the invitation"
msgstr "Άνοιγμα της πρόσκλησης"

msgid "%{name} invited you to an event on %{product} as their guest. Open the invitation to see it and say if you're coming."
msgstr "Ο/Η %{name} σε προσκάλεσε σε μια εκδήλωση στο %{product}. Άνοιξε την πρόσκληση για να τη δεις και να απαντήσεις αν θα έρθεις."

msgid "%{name} asked you to be their check-in buddy on %{product}: someone they can turn to for support."
msgstr "Λάβατε πρόσκληση από %{name} να γίνετε φιλαράκι στήριξης στο %{product}: ένα άτομο στο οποίο μπορεί να απευθύνεται για στήριξη."

msgid "%{name} invited you to train together on %{product}."
msgstr "Λάβατε πρόσκληση από %{name} για κοινή προπόνηση στο %{product}."

msgid "%{name} typed in your address to send you this link. If you don't know them, ignore this email."
msgstr "Τον σύνδεσμο σού τον έστειλε ο/η %{name}, γράφοντας τη διεύθυνσή σου. Αν δεν γνωρίζεις αυτό το άτομο, αγνόησε αυτό το email."

msgid "You're receiving this email because %{name} sent you an invitation through %{product}."
msgstr "Λαμβάνεις αυτό το email επειδή σου έστειλε πρόσκληση ο/η %{name} μέσω του %{product}."
