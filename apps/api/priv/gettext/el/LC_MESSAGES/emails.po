msgid "You're receiving this email because you have a %{product} account."
msgstr "Λαμβάνετε αυτό το email επειδή έχετε λογαριασμό στο %{product}."

msgid "You're receiving this email because %{business} sent it to you through %{product}."
msgstr "Λαμβάνετε αυτό το email επειδή σας το έστειλε η επιχείρηση «%{business}» μέσω του %{product}."

msgid "This email was sent automatically by %{product}."
msgstr "Αυτό το email στάλθηκε αυτόματα από το %{product}."

msgid "If the button doesn't work, copy this link into your browser:"
msgstr "Αν το κουμπί δεν λειτουργεί, αντιγράψτε αυτόν τον σύνδεσμο στο πρόγραμμα περιήγησής σας:"

msgid "If you didn't ask for this, you can safely ignore this email."
msgstr "Αν δεν το ζητήσατε εσείς, απλώς αγνοήστε αυτό το email."

msgid "You're receiving this email because you are the billing contact of %{company} at %{business}."
msgstr "Λαμβάνετε αυτό το email επειδή η επιχείρηση «%{business}» σας έχει δηλώσει ως επαφή τιμολόγησης της εταιρείας «%{company}»."

msgid "This link works only once."
msgstr "Ο σύνδεσμος λειτουργεί μόνο μία φορά."

msgid "Hello %{name},"
msgstr "Γεια σας %{name},"

msgid "Hello,"
msgstr "Γεια σας,"

msgid "Confirm your new email address"
msgstr "Επιβεβαιώστε τη νέα σας διεύθυνση email"

msgid "Someone asked to make this the sign-in address of a %{product} account. Confirm it to finish the change. Until then, the account keeps its current address."
msgstr "Ζητήθηκε αυτή η διεύθυνση να γίνει η διεύθυνση σύνδεσης ενός λογαριασμού στο %{product}. Επιβεβαιώστε την για να ολοκληρωθεί η αλλαγή. Μέχρι τότε, ο λογαριασμός κρατά την τρέχουσα διεύθυνσή του."

msgid "Confirm this address"
msgstr "Επιβεβαίωση διεύθυνσης"

msgid "The link works for 24 hours."
msgstr "Ο σύνδεσμος ισχύει για 24 ώρες."

msgid "You're receiving this email because someone asked to use this address for a %{product} account."
msgstr "Λαμβάνετε αυτό το email επειδή ζητήθηκε να χρησιμοποιηθεί αυτή η διεύθυνση για έναν λογαριασμό στο %{product}."
