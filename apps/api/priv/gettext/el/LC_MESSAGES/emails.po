msgid ""
msgstr ""
"Language: el\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "You're receiving this email because you have a %{product} account."
msgstr "Λαμβάνεις αυτό το email επειδή έχεις λογαριασμό στο %{product}."

msgid "You're receiving this email because %{business} sent it to you through %{product}."
msgstr "Λαμβάνεις αυτό το email επειδή σου το έστειλε η επιχείρηση «%{business}» μέσω του %{product}."

msgid "This email was sent automatically by %{product}."
msgstr "Αυτό το email στάλθηκε αυτόματα από το %{product}."

msgid "If the button doesn't work, copy this link into your browser:"
msgstr "Αν το κουμπί δεν λειτουργεί, αντίγραψε αυτόν τον σύνδεσμο στον browser σου:"

msgid "If you didn't ask for this, you can safely ignore this email."
msgstr "Αν δεν το ζήτησες εσύ, απλώς αγνόησε αυτό το email."

msgid "You're receiving this email because you are the billing contact of %{company} at %{business}."
msgstr "Λαμβάνετε αυτό το email επειδή η επιχείρηση «%{business}» σας έχει δηλώσει ως επαφή τιμολόγησης της εταιρείας «%{company}»."

msgid "This link works only once."
msgstr "Ο σύνδεσμος λειτουργεί μόνο μία φορά."

msgid "Hello %{name},"
msgstr "Γεια σου %{name},"

msgid "Hello,"
msgstr "Γεια σου,"

# ADR-213: verify_email

msgid "Confirm your email address"
msgstr "Επιβεβαίωσε τη διεύθυνση email σου"

msgid "Please confirm that %{email} is your email address. It lets you get back into your account if you ever forget your password."
msgstr "Επιβεβαίωσε ότι το %{email} είναι η διεύθυνση email σου. Έτσι θα μπορείς να μπεις ξανά στον λογαριασμό σου, αν ξεχάσεις ποτέ τον κωδικό σου."

msgid "Confirm email"
msgstr "Επιβεβαίωση email"

msgid "This link expires in 48 hours."
msgstr "Ο σύνδεσμος λήγει σε 48 ώρες."

msgid "If you didn't create a %{product} account, you can ignore this email."
msgstr "Αν δεν δημιούργησες λογαριασμό στο %{product}, απλώς αγνόησε αυτό το email."
msgid "Activate %{business} on %{product}"
msgstr "Ενεργοποίησε την επιχείρηση «%{business}» στο %{product}"
msgid "Your business is ready to go live"
msgstr "Η επιχείρησή σου είναι έτοιμη να ξεκινήσει"
msgid "The %{product} team approved %{business}. Open the link while signed in to your account to activate it: the demo data is removed and the business goes live."
msgstr "Η ομάδα του %{product} ενέκρινε την επιχείρηση «%{business}». Άνοιξε τον σύνδεσμο ενώ είσαι συνδεδεμένος/η στον λογαριασμό σου για να την ενεργοποιήσεις: τα demo δεδομένα αφαιρούνται και η επιχείρηση ξεκινά να λειτουργεί κανονικά."
msgid "Your role: owner."
msgstr "Ο ρόλος σου: ιδιοκτήτης."
msgid "Your role: admin."
msgstr "Ο ρόλος σου: διαχειριστής."
msgid "Activate business"
msgstr "Ενεργοποίηση επιχείρησης"
msgid "It opens only for your own account."
msgstr "Ανοίγει μόνο για τον δικό σου λογαριασμό."
# ADR-208: security notices
msgid "You're receiving this security notice because it concerns your %{product} account. Security notices can't be turned off."
msgstr "Λαμβάνεις αυτή την ειδοποίηση ασφαλείας επειδή αφορά τον λογαριασμό σου στο %{product}. Οι ειδοποιήσεις ασφαλείας δεν απενεργοποιούνται."
msgid "%{product} app"
msgstr "Εφαρμογή %{product}"
msgid "%{product} app on %{platform}"
msgstr "Εφαρμογή %{product} σε %{platform}"
msgid "%{client} on %{platform}"
msgstr "%{client} σε %{platform}"
msgid "Your password was changed"
msgstr "Ο κωδικός πρόσβασής σου άλλαξε"
msgid "The password of your %{product} account was changed in Settings."
msgstr "Ο κωδικός πρόσβασης του λογαριασμού σου στο %{product} άλλαξε από τις Ρυθμίσεις."
msgid "Your password was reset"
msgstr "Ο κωδικός πρόσβασής σου επαναφέρθηκε"
msgid "The password of your %{product} account was reset, and every device was signed out."
msgstr "Ο κωδικός πρόσβασης του λογαριασμού σου στο %{product} επαναφέρθηκε και έγινε αποσύνδεση από όλες τις συσκευές."
msgid "Someone signed in to your %{product} account asked to change its email address to %{email}. Nothing changes until the new address is confirmed."
msgstr "Κάποιος που είναι συνδεδεμένος στον λογαριασμό σου στο %{product} ζήτησε να αλλάξει η διεύθυνση email του σε %{email}. Τίποτα δεν αλλάζει μέχρι να επιβεβαιωθεί η νέα διεύθυνση."
msgid "Someone signed in to your %{product} account asked to change its email address. Nothing changes until the new address is confirmed."
msgstr "Κάποιος που είναι συνδεδεμένος στον λογαριασμό σου στο %{product} ζήτησε να αλλάξει η διεύθυνση email του. Τίποτα δεν αλλάζει μέχρι να επιβεβαιωθεί η νέα διεύθυνση."
msgid "A change of your email address was requested"
msgstr "Ζητήθηκε αλλαγή της διεύθυνσης email σου"
msgid "The email address of your %{product} account was changed to %{email}. Emails about your account now go there."
msgstr "Η διεύθυνση email του λογαριασμού σου στο %{product} άλλαξε σε %{email}. Τα email για τον λογαριασμό σου πηγαίνουν πλέον εκεί."
msgid "The email address of your %{product} account was changed. Emails about your account now go to the new address."
msgstr "Η διεύθυνση email του λογαριασμού σου στο %{product} άλλαξε. Τα email για τον λογαριασμό σου πηγαίνουν πλέον στη νέα διεύθυνση."
msgid "Your email address was changed"
msgstr "Η διεύθυνση email σου άλλαξε"
msgid "If this was you, there's nothing else to do."
msgstr "Αν ήσασταν εσείς, δεν χρειάζεται να κάνετε τίποτε άλλο."
msgid "If this wasn't you, undo the change right away. Then sign out everywhere and choose a new password."
msgstr "Αν δεν ήσουν εσύ, αναίρεσε αμέσως την αλλαγή. Μετά αποσυνδέσου από παντού και όρισε νέο κωδικό πρόσβασης."
msgid "Undo this change"
msgstr "Αναίρεση της αλλαγής"
msgid "A recovery code was used"
msgstr "Χρησιμοποιήθηκε κωδικός ανάκτησης"
msgid "One of your recovery codes was used to set a new password for your %{product} account, and every device was signed out."
msgstr "Ένας από τους κωδικούς ανάκτησής σου χρησιμοποιήθηκε για να οριστεί νέος κωδικός πρόσβασης στον λογαριασμό σου στο %{product} και έγινε αποσύνδεση από όλες τις συσκευές."
msgid "New recovery codes were created"
msgstr "Δημιουργήθηκαν νέοι κωδικοί ανάκτησης"
msgid "New recovery codes were created for your %{product} account. The old codes no longer work."
msgstr "Δημιουργήθηκαν νέοι κωδικοί ανάκτησης για τον λογαριασμό σου στο %{product}. Οι παλιοί κωδικοί δεν ισχύουν πλέον."
msgid "You have no unused recovery codes left."
msgstr "Δεν σου έχει μείνει κανένας αχρησιμοποίητος κωδικός ανάκτησης."
msgid "You have only one unused recovery code left."
msgstr "Σου έχει μείνει μόνο ένας αχρησιμοποίητος κωδικός ανάκτησης."
msgid "You have only two unused recovery codes left."
msgstr "Σου έχουν μείνει μόνο δύο αχρησιμοποίητοι κωδικοί ανάκτησης."
msgid "You're running out of recovery codes"
msgstr "Οι κωδικοί ανάκτησής σου τελειώνουν"
msgid "Create new codes in Settings and keep them somewhere safe, so you can always get back into your account."
msgstr "Δημιουργήστε νέους κωδικούς από τις Ρυθμίσεις και φυλάξτε τους σε ασφαλές μέρος, ώστε να μπορείτε πάντα να μπείτε ξανά στον λογαριασμό σας."
msgid "Open Settings"
msgstr "Άνοιγμα Ρυθμίσεων"
msgid "You were signed out everywhere"
msgstr "Αποσυνδεθήκατε από παντού"
msgid "Every device signed in to your %{product} account was signed out."
msgstr "Έγινε αποσύνδεση από κάθε συσκευή που ήταν συνδεδεμένη στον λογαριασμό σου στο %{product}."
msgid "If this wasn't you, choose a new password right away."
msgstr "Αν δεν ήσουν εσύ, όρισε αμέσως νέο κωδικό πρόσβασης."
msgid "Choose a new password"
msgstr "Ορισμός νέου κωδικού πρόσβασης"
msgid "A new profile was added to your %{product} account: %{profile}."
msgstr "Προστέθηκε νέο προφίλ στον λογαριασμό σου στο %{product}: %{profile}."
msgid "A new profile was added to your %{product} account."
msgstr "Προστέθηκε νέο προφίλ στον λογαριασμό σου στο %{product}."
msgid "A profile was added to your account"
msgstr "Προστέθηκε προφίλ στον λογαριασμό σου"
msgid "New sign-in to your account"
msgstr "Νέα σύνδεση στον λογαριασμό σου"
msgid "Your %{product} account was just used to sign in on a device it hasn't been used on before."
msgstr "Μόλις έγινε σύνδεση στον λογαριασμό σου στο %{product} από συσκευή που δεν είχε χρησιμοποιηθεί ποτέ πριν."
msgid "Your profile will be deleted"
msgstr "Το προφίλ σου θα διαγραφεί"
msgid "Your profile %{profile} on %{product} will be deleted on %{date}."
msgstr "Το προφίλ σου %{profile} στο %{product} θα διαγραφεί στις %{date}."
msgid "Your account will be deleted"
msgstr "Ο λογαριασμός σου θα διαγραφεί"
msgid "Your %{product} account and all its profiles will be deleted on %{date}."
msgstr "Ο λογαριασμός σου στο %{product} και όλα τα προφίλ του θα διαγραφούν στις %{date}."
msgid "Changed your mind? You can undo it until then."
msgstr "Άλλαξες γνώμη; Μπορείς να το αναιρέσεις μέχρι τότε."
msgid "If this wasn't you, undo the deletion right away. Then sign out everywhere and choose a new password."
msgstr "Αν δεν ήσουν εσύ, αναίρεσε αμέσως τη διαγραφή. Μετά αποσυνδέσου από παντού και όρισε νέο κωδικό πρόσβασης."
msgid "Undo the deletion"
msgstr "Αναίρεση της διαγραφής"
msgid "Your profile was deleted"
msgstr "Το προφίλ σου διαγράφηκε"
msgid "Your profile %{profile} on %{product} was deleted, as you asked."
msgstr "Το προφίλ σου %{profile} στο %{product} διαγράφηκε, όπως ζήτησες."
msgid "Your account was deleted"
msgstr "Ο λογαριασμός σου διαγράφηκε"
msgid "Your %{product} account and all its profiles were deleted, as you asked."
msgstr "Ο λογαριασμός σου στο %{product} και όλα τα προφίλ του διαγράφηκαν, όπως ζήτησες."
msgid "If this wasn't you, sign out everywhere right away, then choose a new password."
msgstr "Αν δεν ήσουν εσύ, αποσυνδέσου αμέσως από παντού και μετά όρισε νέο κωδικό πρόσβασης."
msgid "Sign out everywhere"
msgstr "Αποσύνδεση από παντού"
msgid "The sign-out link signs out every device, including this one, and works for 7 days."
msgstr "Ο σύνδεσμος αποσύνδεσης αποσυνδέει όλες τις συσκευές, μαζί και αυτήν, και ισχύει για 7 ημέρες."
msgid "When"
msgstr "Πότε"
msgid "Device"
msgstr "Συσκευή"
msgid "Location"
msgstr "Τοποθεσία"
msgid "IP address"
msgstr "Διεύθυνση IP"
msgid "Reset your %{product} password"
msgstr "Επαναφορά κωδικού πρόσβασης στο %{product}"
msgid "Reset your password"
msgstr "Επαναφορά κωδικού πρόσβασης"
msgid "Someone asked to reset the password of your %{product} account. To choose a new password, use the button below."
msgstr "Ζητήθηκε επαναφορά του κωδικού πρόσβασης του λογαριασμού σου στο %{product}. Για να ορίσεις νέο κωδικό, πάτησε το παρακάτω κουμπί."
msgid "This link works for 1 hour."
msgstr "Ο σύνδεσμος ισχύει για 1 ώρα."
msgid "Setting a new password signs you out on every device."
msgstr "Με τον νέο κωδικό αποσυνδέεσαι από όλες τις συσκευές σου."
msgid "Your password has not been changed."
msgstr "Ο κωδικός σου δεν έχει αλλάξει."
msgid "Unsubscribe from these emails"
msgstr "Διακοπή αυτών των email"
msgid "You will no longer receive this kind of email from %{product}. Emails about your account and its security still arrive."
msgstr "Δεν θα λαμβάνεις πλέον αυτό το είδος email από το %{product}. Τα email για τον λογαριασμό σου και την ασφάλειά του θα συνεχίσουν να φτάνουν."
msgid "You're unsubscribed"
msgstr "Η εγγραφή σου καταργήθηκε"
msgid "This unsubscribe link is not valid."
msgstr "Αυτός ο σύνδεσμος διακοπής δεν είναι έγκυρος."



msgid "Confirm your new email address"
msgstr "Επιβεβαίωσε τη νέα σου διεύθυνση email"

msgid "Someone asked to make this the sign-in address of a %{product} account. Confirm it to finish the change. Until then, the account keeps its current address."
msgstr "Ζητήθηκε αυτή η διεύθυνση να γίνει η διεύθυνση σύνδεσης ενός λογαριασμού στο %{product}. Επιβεβαίωσέ την για να ολοκληρωθεί η αλλαγή. Μέχρι τότε, ο λογαριασμός κρατά την τρέχουσα διεύθυνσή του."

msgid "Confirm this address"
msgstr "Επιβεβαίωση διεύθυνσης"

msgid "The link works for 24 hours."
msgstr "Ο σύνδεσμος ισχύει για 24 ώρες."

msgid "You're receiving this email because someone asked to use this address for a %{product} account."
msgstr "Λαμβάνεις αυτό το email επειδή ζητήθηκε να χρησιμοποιηθεί αυτή η διεύθυνση για έναν λογαριασμό στο %{product}."

msgid "%{title} %{number} from %{business}"
msgstr "%{title} %{number} από %{business}"

msgid "%{business} sent you this document. You'll find it attached as a PDF."
msgstr "Η επιχείρηση %{business} σού έστειλε αυτό το παραστατικό. Θα το βρεις συνημμένο σε PDF."

msgid "Document"
msgstr "Παραστατικό"

msgid "Date of issue"
msgstr "Ημερομηνία έκδοσης"

msgid "Total"
msgstr "Σύνολο"

msgid "Keep it for your records. For questions about it, contact the business."
msgstr "Κράτησέ το στο αρχείο σου. Για απορίες σχετικά με αυτό, επικοινώνησε με την επιχείρηση."
