msgid ""
msgstr ""
"Language: el\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Someone tried to sign up with your email"
msgstr "Κάποιος προσπάθησε να εγγραφεί με το email σου"

msgid "Someone tried to create a %{product} account with this email address."
msgstr "Κάποιος προσπάθησε να δημιουργήσει λογαριασμό στο %{product} με αυτή τη διεύθυνση email."

msgid "If it was you, sign in to add a profile, or reset your password if you forgot it."
msgstr "Αν ήσουν εσύ, συνδέσου για να προσθέσεις προφίλ ή κάνε επαναφορά του κωδικού σου, αν τον ξέχασες."

msgid "Sign in"
msgstr "Σύνδεση"

msgid "Reset password"
msgstr "Επαναφορά κωδικού"

msgid "Forgot your password?"
msgstr "Ξέχασες τον κωδικό σου;"

msgid "If it wasn't you, you can ignore this email. No account was created and nothing changed."
msgstr "Αν δεν ήσουν εσύ, αγνόησε αυτό το email. Δεν δημιουργήθηκε λογαριασμός και δεν άλλαξε τίποτα."

msgid "Confirm deleting your account"
msgstr "Επιβεβαίωσε τη διαγραφή του λογαριασμού σου"

msgid "You asked to delete your profile @%{handle}."
msgstr "Ζήτησες να διαγραφεί το προφίλ σου @%{handle}."

msgid "You asked to delete your account with all its profiles."
msgstr "Ζήτησες να διαγραφεί ο λογαριασμός σου μαζί με όλα τα προφίλ του."

msgid "Confirm deleting your profile"
msgstr "Επιβεβαίωσε τη διαγραφή του προφίλ σου"

msgid "After you confirm, the deletion takes place in %{days} days. Until then you can undo it."
msgstr "Μόλις επιβεβαιώσεις, η διαγραφή θα γίνει σε %{days} ημέρες. Μέχρι τότε μπορείς να την αναιρέσεις."

msgid "Confirm deletion"
msgstr "Επιβεβαίωση διαγραφής"

msgid "The link expires in 24 hours."
msgstr "Ο σύνδεσμος λήγει σε 24 ώρες."

msgid "If you didn't ask for this, don't open the link and change your password: someone else knows it."
msgstr "Αν δεν το ζήτησες εσύ, μην ανοίξεις τον σύνδεσμο και άλλαξε τον κωδικό σου: κάποιος άλλος τον γνωρίζει."
