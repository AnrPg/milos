msgstr "Μπήκες στην «%{group}»."

msgid "Your group is quiet"
msgstr "Η ομάδα σου είναι ήσυχη"

msgid "Nobody has posted in «%{group}» for a while. Post something or it will be archived."
msgstr "Κανείς δεν έχει γράψει στην «%{group}» εδώ και καιρό. Γράψε κάτι, αλλιώς θα αρχειοθετηθεί."

msgid "New report"
msgstr "Νέα αναφορά"

msgid "Someone reported something in the club."
msgstr "Κάποιος ανέφερε κάτι στο club."

