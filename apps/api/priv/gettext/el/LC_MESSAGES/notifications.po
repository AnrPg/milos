msgstr "Ο/Η %{nickname} γράφτηκε, με πρόσκληση από %{referrer}."

msgid "New near you"
msgstr "Νέα γύρω σου"

msgid "New for «%{name}»: %{count}"
msgstr "Νέα για «%{name}»: %{count}"

msgid "Visitor at the door"
msgstr "Επισκέπτης στην πόρτα"

msgid "%{nickname} scanned the door at %{box} (%{when}) - not a member yet."
msgstr "Ο/Η %{nickname} σκάναρε την πόρτα στο %{box} (%{when}) - δεν είναι ακόμη μέλος."

msgid "%{nickname} scanned the door at %{box} (%{when}) - not a member yet. Trials are open."
msgstr "Ο/Η %{nickname} σκάναρε την πόρτα στο %{box} (%{when}) - δεν είναι ακόμη μέλος. Οι δοκιμαστικές είναι ανοιχτές."

msgid "Time for a new measurement"
msgstr "Ώρα για νέα μέτρηση"

msgid "A new snapshot helps you see your trend. It takes a minute."
msgstr "Ένα νέο στιγμιότυπο σε βοηθά να δεις την τάση σου. Παίρνει ένα λεπτό."

msgid "A buddy invitation"
msgstr "Πρόσκληση για buddy"

msgid "%{nickname} asks you to be their support buddy."
msgstr "Ο/Η %{nickname} σου ζητά να γίνεις buddy στήριξης."

msgid "You have a support buddy"
msgstr "Έχεις buddy στήριξης"

msgid "%{nickname} accepted. They hear from you only when you ask."
msgstr "Ο/Η %{nickname} αποδέχτηκε. Θα μαθαίνει μόνο όταν το ζητάς εσύ."

msgid "%{nickname} is having a hard moment"
msgstr "Ο/Η %{nickname} περνάει μια δύσκολη στιγμή"

msgid "I'm here · Shall we go for a walk? · Call me"
msgstr "Είμαι εδώ · Πάμε βόλτα; · Πάρε με τηλέφωνο"

msgid "%{nickname}: Shall we go for a walk?"
msgstr "%{nickname}: Πάμε βόλτα;"

msgid "%{nickname}: Call me"
msgstr "%{nickname}: Πάρε με τηλέφωνο"

msgid "%{nickname}: I'm here"
msgstr "%{nickname}: Είμαι εδώ"

msgid "%{nickname} replied"
msgstr "Ο/Η %{nickname} απάντησε"

msgid "No one has replied yet"
msgstr "Δεν απάντησε κανείς ακόμα"

msgid "Until then, something small: two minutes of breathing, a glass of water, a short walk."
msgstr "Μέχρι τότε, κάτι μικρό: δύο λεπτά αναπνοή, ένα ποτήρι νερό, μια μικρή βόλτα."

msgid "%{nickname}'s week"
msgstr "Η εβδομάδα του/της %{nickname}"

msgid "%{moments} hard moments, %{overcome} overcome, %{requests} requests for support."
msgstr "%{moments} δύσκολες στιγμές, οι %{overcome} ξεπεράστηκαν, %{requests} αιτήματα στήριξης."

msgid "I'm here"
msgstr "Είμαι εδώ"

msgid "Shall we go for a walk?"
msgstr "Πάμε βόλτα;"

msgid "Call me"
msgstr "Πάρε με τηλέφωνο"

msgid "How did it go?"
msgstr "Πώς πήγε;"

msgid "A quick note on earlier helps you see what works for you."
msgstr "Μια σύντομη σημείωση για πριν σε βοηθά να δεις τι σου ταιριάζει."

msgid "A glass of water?"
msgstr "Ένα ποτήρι νερό;"

msgid "The afternoon is a good moment to catch up on water."
msgstr "Το απόγευμα είναι καλή στιγμή να προλάβεις το νερό σου."

msgid "Buddy message"
msgstr "Μήνυμα από buddy"

msgid "%{nickname}: weekly wellness"
msgstr "%{nickname}: εβδομαδιαία ευεξία"

msgid "%{sleep} nights at the sleep goal, %{water} days on water, %{meals} days with meals logged."
msgstr "%{sleep} νύχτες στον στόχο ύπνου, %{water} μέρες με νερό, %{meals} μέρες με καταγραφή γευμάτων."

msgid "Garmin stopped syncing"
msgstr "Ο συγχρονισμός με το Garmin σταμάτησε"

msgid "Reconnect it from Connected devices to bring your workouts in again."
msgstr "Κάνε επανασύνδεση από τις Συνδεδεμένες συσκευές για να έρχονται ξανά οι προπονήσεις σου."

msgid "Your journal export is ready"
msgstr "Η εξαγωγή του ημερολογίου σου είναι έτοιμη"

msgid "Download it within seven days from Settings."
msgstr "Κατέβασέ την μέσα σε επτά μέρες από τις Ρυθμίσεις."

msgid "Season request"
msgstr "Αίτημα για season"

msgid "%{nickname} asks for a place in %{season}."
msgstr "Ο/Η %{nickname} ζητά θέση στο %{season}."

msgid "%{nickname} joined the waitlist of %{season}."
msgstr "Ο/Η %{nickname} μπήκε στη λίστα αναμονής για το %{season}."

msgid "Your place is confirmed"
msgstr "Η θέση σου επιβεβαιώθηκε"

msgid "%{season} starts on %{date}. The programme is in your Box."
msgstr "Το %{season} ξεκινά στις %{date}. Το πρόγραμμα είναι στο Box σου."

msgid "Season request not confirmed"
msgstr "Το αίτημα για season δεν επιβεβαιώθηκε"

msgid "%{box} could not confirm your place in %{season}."
msgstr "Το %{box} δεν μπόρεσε να επιβεβαιώσει τη θέση σου στο %{season}."

msgid "Season cancelled"
msgstr "Το season ακυρώθηκε"

msgid "%{box} cancelled %{season}."
msgstr "Το %{box} ακύρωσε το %{season}."

msgid "You found a training partner"
msgstr "Βρήκες training partner"

msgid "You and %{nickname} both want to train together. Say hi."
msgstr "Εσύ και το %{nickname} θέλετε να προπονηθείτε μαζί. Πείτε ένα γεια."

msgid "Training partner message"
msgstr "Μήνυμα από training partner"

msgid "Squad invitation"
msgstr "Πρόσκληση σε squad"

msgid "%{nickname} invited you to the squad «%{group}»."
msgstr "Ο/Η %{nickname} σε προσκάλεσε στο squad «%{group}»."

# ADR-176: a class without its WOD.
msgid "A class has no WOD"
msgstr "Μάθημα χωρίς WOD"

msgid "%{class} (%{when}) has no WOD, so members can't see or book it. Link one to publish it."
msgstr "Το %{class} (%{when}) δεν έχει WOD, οπότε τα μέλη δεν το βλέπουν και δεν μπορούν να κλείσουν θέση. Σύνδεσε ένα για να δημοσιευτεί."

msgid "%{class} (%{when}) starts in an hour and still has no WOD."
msgstr "Το %{class} (%{when}) ξεκινά σε μία ώρα και ακόμη δεν έχει WOD."

msgid "%{class} (%{when}) has no WOD yet. Link one before it starts."
msgstr "Το %{class} (%{when}) δεν έχει ακόμη WOD. Σύνδεσε ένα πριν ξεκινήσει."

