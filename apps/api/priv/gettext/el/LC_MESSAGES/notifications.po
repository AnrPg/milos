msgstr "Το %{box} δεν μπορεί να σε δεχτεί στο %{class}."

msgid "Your trial is soon"
msgstr "Το δοκιμαστικό σου πλησιάζει"

msgid "%{class} at %{box} (%{when})."
msgstr "%{class} στο %{box} (%{when})."

msgid "How was your trial?"
msgstr "Πώς σου φάνηκε το δοκιμαστικό;"

msgid "Want to keep training at %{box}? Send them a message."
msgstr "Θες να συνεχίσεις στο %{box}; Στείλε τους μήνυμα."

