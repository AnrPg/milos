msgid "New booking request"
msgstr "Νέα αίτηση κράτησης"

msgid "Booking approved"
msgstr "Εγκρίθηκε η κράτηση"

msgid "Booking rejected"
msgstr "Η κράτηση απορρίφθηκε"

msgid "Booking timed out"
msgstr "Το χρονικό όριο της κράτησης έληξε"

msgid "Open the schedule to review the latest booking state."
msgstr "Ανοίξτε το πρόγραμμα για να ελέγξετε την πιο πρόσφατη κατάσταση κράτησης."

msgid "Workout annotation"
msgstr "Σχολιασμός προπόνησης"

msgid "A workout annotation needs review."
msgstr "Ένας σχολιασμός προπόνησης χρειάζεται έλεγχο."

msgid "Workout changed"
msgstr "Η προπόνηση άλλαξε"

msgid "Your coach changed a scheduled workout."
msgstr "Ο προπονητής σας άλλαξε μια προγραμματισμένη προπόνηση."

msgid "Workout removed"
msgstr "Η προπόνηση καταργήθηκε"

msgid "Your coach removed a scheduled workout."
msgstr "Ο προπονητής σας αφαίρεσε μια προγραμματισμένη προπόνηση."

msgid "Workout rejected"
msgstr "Η προπόνηση απορρίφθηκε"

msgid "An athlete"
msgstr "Ένας αθλητής"

msgid "a workout"
msgstr "μια προπόνηση"

msgid "%{nickname} rejected %{title}."
msgstr "Ο %{nickname} απέρριψε το %{title}."

msgid "Workout rescheduled"
msgstr "Η προπόνηση επαναπρογραμματίστηκε"

msgid "An athlete rescheduled their workout."
msgstr "Ένας αθλητής ξαναπρογραμμάτισε την προπόνησή του."

msgid "Message from %{nickname}"
msgstr "Μήνυμα από %{nickname}"

msgid "%{nickname} sent you a message."
msgstr "Το %{nickname} σας έστειλε ένα μήνυμα."

msgid "Message from your coach"
msgstr "Μήνυμα από τον coach σου"

msgid "Your coach sent you a message."
msgstr "Ο coach σου σού έστειλε μήνυμα."

msgid "Message from the box"
msgstr "Μήνυμα από το box"

msgid "Your gym sent you a message."
msgstr "Το box σου σού έστειλε μήνυμα."

msgid "Challenge completed"
msgstr "Η πρόκληση ολοκληρώθηκε"

msgid "You completed a challenge."
msgstr "Ολοκληρώσατε μια πρόκληση."

msgid "New message in your workout thread"
msgstr "Νέο μήνυμα στο νήμα της προπόνησής σας"

msgid "New message"
msgstr "Νέο μήνυμα"

msgid "You received a new message."
msgstr "Λάβατε νέο μήνυμα."

msgid "TrainingJournal"
msgstr "Μήλος Προπόνηση"

msgid "You have a new notification."
msgstr "Έχετε μια νέα ειδοποίηση."

msgid "invoice"
msgstr "τιμολόγιο"

msgid "New invoice"
msgstr "Νέο τιμολόγιο"

msgid "Invoice %{invoice_number} has been issued for your account."
msgstr "Το τιμολόγιο %{invoice_number} έχει εκδοθεί για τον λογαριασμό σας."

msgid "Payment reminder"
msgstr "Υπενθύμιση πληρωμής"

msgid "You have an outstanding balance of %{amount} due."
msgstr "Έχετε ένα οφειλόμενο υπόλοιπο %{amount}."

msgid "Workout assignment requested"
msgstr "Ζητήθηκε ανάθεση προπόνησης"

msgid "%{nickname} requested a workout assignment for %{requested_for}."
msgstr "Ο/Η %{nickname} ζήτησε ανάθεση προπόνησης για τις %{requested_for}."

msgid "a requested date"
msgstr "μια ζητούμενη ημερομηνία"

msgid "New review submitted"
msgstr "Υποβλήθηκε νέα αξιολόγηση"

msgid "general"
msgstr "γενική"

msgid "A %{target_type} review was submitted with a %{rating}/5 rating."
msgstr "Υποβλήθηκε αξιολόγηση %{target_type} με βαθμολογία %{rating}/5."

msgid "A new %{target_type} review needs attention."
msgstr "Μια νέα αξιολόγηση %{target_type} χρειάζεται έλεγχο."

msgid "Class bookings approved"
msgstr "Εγκρίθηκαν κρατήσεις μαθημάτων"

msgid "Your coach approved one or more class booking requests."
msgstr "Ο προπονητής σας ενέκρινε ένα ή περισσότερα αιτήματα κράτησης μαθημάτων."

msgid "New workouts assigned"
msgstr "Ανατέθηκαν νέες προπονήσεις"

msgid "Your coach assigned one or more workouts to you."
msgstr "Ο προπονητής σας ανέθεσε μία ή περισσότερες προπονήσεις."

msgid "You got a spot"
msgstr "Βρέθηκε θέση για σένα"

msgid "A place opened up in %{class}. Your booking is confirmed or awaiting approval."
msgstr "Άνοιξε θέση στο %{class}. Η κράτησή σου επιβεβαιώθηκε ή περιμένει έγκριση."

msgid "Your package ends soon"
msgstr "Το πακέτο σου λήγει σύντομα"

msgid "%{package} ends on %{date}."
msgstr "Το %{package} λήγει στις %{date}."

msgid "New form review request"
msgstr "Νέο αίτημα αξιολόγησης τεχνικής"

msgid "%{client} sent a video for feedback."
msgstr "Ο/Η %{client} έστειλε βίντεο για σχόλια."

msgid "Your form review is ready"
msgstr "Η αξιολόγηση τεχνικής σου είναι έτοιμη"

msgid "Your coach left feedback on your video."
msgstr "Ο προπονητής σου άφησε σχόλια στο βίντεό σου."

msgid "A client is waiting for a reply"
msgstr "Ένας πελάτης περιμένει απάντηση"

msgid "%{client} has been waiting longer than the promised reply time."
msgstr "Ο/Η %{client} περιμένει περισσότερο από τον χρόνο απάντησης που υποσχεθήκαμε."

msgid "Your nutrition plan was updated"
msgstr "Το διατροφικό σου πλάνο ενημερώθηκε"

msgid "Open it to see what changed."
msgstr "Άνοιξέ το για να δεις τι άλλαξε."

msgid "New appointment booked"
msgstr "Νέο ραντεβού"

msgid "%{client} booked a session for %{time}."
msgstr "Ο/Η %{client} έκλεισε συνεδρία για %{time}."

msgid "Appointment cancelled"
msgstr "Το ραντεβού ακυρώθηκε"

msgid "The session on %{time} was cancelled."
msgstr "Η συνεδρία της %{time} ακυρώθηκε."

msgid "A coach took a new athlete"
msgstr "Ένας coach ανέλαβε νέο αθλητή"

msgid "%{coach} is now coaching %{client}."
msgstr "Ο/Η %{coach} προπονεί πλέον τον/την %{client}."

msgid "An admin read your note"
msgstr "Ένας admin διάβασε τη σημείωσή σας"

msgid "%{reader} read your note about %{client} at %{time}."
msgstr "Ο/Η %{reader} διάβασε τη σημείωσή σας για τον/την %{client} στις %{time}."

msgid "A machine needs attention"
msgstr "Ένα μηχάνημα χρειάζεται προσοχή"

msgid "%{machine}: %{note}"
msgstr "%{machine}: %{note}"

msgid "Reported running low"
msgstr "Αναφέρθηκε χαμηλό απόθεμα"

msgid "%{item}: %{note}"
msgstr "%{item}: %{note}"

msgid "Inventory today"
msgstr "Απόθεμα σήμερα"

msgid "Needs attention: %{items}"
msgstr "Χρειάζονται προσοχή: %{items}"

msgid "Running low"
msgstr "Χαμηλό απόθεμα"

msgid "%{item}: %{quantity} left."
msgstr "%{item}: απομένουν %{quantity}."

msgid "Your subscription ends soon"
msgstr "Η συνδρομή σας λήγει σύντομα"

msgid "Your subscription has ended"
msgstr "Η συνδρομή σας έληξε"

msgid "your subscription"
msgstr "η συνδρομή σας"

msgid "%{package} ends on %{date} (in %{days} days). Renew to keep booking classes."
msgstr "Η συνδρομή %{package} λήγει στις %{date} (σε %{days} ημέρες). Ανανεώστε για να συνεχίσετε να κλείνετε μαθήματα."

msgid "%{package} has ended. You keep access until %{date}; renew before then to keep booking classes."
msgstr "Η συνδρομή %{package} έληξε. Διατηρείτε πρόσβαση έως τις %{date}· ανανεώστε μέχρι τότε για να συνεχίσετε να κλείνετε μαθήματα."

msgid "Your access has ended"
msgstr "Η πρόσβασή σας έληξε"

msgid "Your access is paused because a payment is overdue. Pay the outstanding balance to book classes again."
msgstr "Η πρόσβασή σας έχει παγώσει επειδή μια πληρωμή καθυστερεί. Εξοφλήστε το υπόλοιπο για να κλείνετε ξανά μαθήματα."

msgid "Your access has ended. Renew your subscription to book classes again."
msgstr "Η πρόσβασή σας έληξε. Ανανεώστε τη συνδρομή σας για να κλείνετε ξανά μαθήματα."

msgid "Your upcoming bookings were cancelled: %{count}."
msgstr "Οι επερχόμενες κρατήσεις σας ακυρώθηκαν: %{count}."

msgid "Follow request"
msgstr "Αίτημα ακολούθησης"

msgid "%{nickname} wants to follow you."
msgstr "Ο/Η %{nickname} θέλει να σε ακολουθήσει."

msgid "Follow request accepted"
msgstr "Το αίτημα ακολούθησης έγινε δεκτό"

msgid "You now follow %{nickname}."
msgstr "Τώρα ακολουθείς τον/την %{nickname}."

msgid "Trial request"
msgstr "Αίτημα δοκιμαστικού"

msgid "%{nickname} asks to try %{class} (%{when})."
msgstr "Ο/Η %{nickname} ζητά δοκιμαστικό στο %{class} (%{when})."

msgid "New trial"
msgstr "Νέο δοκιμαστικό"

msgid "%{nickname} booked a trial in %{class} (%{when})."
msgstr "Ο/Η %{nickname} έκλεισε δοκιμαστικό στο %{class} (%{when})."

msgid "Trial cancelled"
msgstr "Ακυρώθηκε δοκιμαστικό"

msgid "%{nickname} cancelled their trial in %{class}."
msgstr "Ο/Η %{nickname} ακύρωσε το δοκιμαστικό στο %{class}."

msgid "Your trial is booked"
msgstr "Το δοκιμαστικό σου κλείστηκε"

msgid "%{box}: %{class} (%{when})."
msgstr "%{box}: %{class} (%{when})."

msgid "Trial not accepted"
msgstr "Το δοκιμαστικό δεν έγινε δεκτό"

msgid "%{box} couldn't take you in %{class}."
msgstr "Το %{box} δεν μπορεί να σε δεχτεί στο %{class}."

msgid "Your trial is soon"
msgstr "Το δοκιμαστικό σου πλησιάζει"

msgid "%{class} at %{box} (%{when})."
msgstr "%{class} στο %{box} (%{when})."

msgid "How was your trial?"
msgstr "Πώς σου φάνηκε το δοκιμαστικό;"

msgid "Want to keep training at %{box}? Send them a message."
msgstr "Θες να συνεχίσεις στο %{box}; Στείλε τους μήνυμα."

msgid "Trial class cancelled"
msgstr "Ακυρώθηκε το μάθημα του δοκιμαστικού"

msgid "%{box} cancelled %{class} (%{when}). Pick another class."
msgstr "Το %{box} ακύρωσε το %{class} (%{when}). Διάλεξε άλλο μάθημα."

msgid "New group to review"
msgstr "Νέα ομάδα για έγκριση"

msgid "%{nickname} wants to start «%{group}»."
msgstr "Ο/Η %{nickname} θέλει να ξεκινήσει την «%{group}»."

msgid "Your group is live"
msgstr "Η ομάδα σου είναι ενεργή"

msgid "«%{group}» is open. Invite people in."
msgstr "Η «%{group}» άνοιξε. Κάλεσε κόσμο."

msgid "Group not approved"
msgstr "Η ομάδα δεν εγκρίθηκε"

msgid "The box didn't approve «%{group}»."
msgstr "Το box δεν ενέκρινε την «%{group}»."

msgid "Request to join"
msgstr "Αίτημα συμμετοχής"

msgid "%{nickname} asks to join «%{group}»."
msgstr "Ο/Η %{nickname} ζητά να μπει στην «%{group}»."

msgid "You're in"
msgstr "Είσαι μέσα"

msgid "You joined «%{group}»."
msgstr "Μπήκες στην «%{group}»."

msgid "Your group is quiet"
msgstr "Η ομάδα σου είναι ήσυχη"

msgid "Nobody has posted in «%{group}» for a while. Post something or it will be archived."
msgstr "Κανείς δεν έχει γράψει στην «%{group}» εδώ και καιρό. Γράψε κάτι, αλλιώς θα αρχειοθετηθεί."

msgid "New report"
msgstr "Νέα αναφορά"

msgid "Someone reported something in the club."
msgstr "Κάποιος ανέφερε κάτι στο club."

msgid "A place opened up"
msgstr "Άνοιξε θέση"

msgid "You're going to «%{event}» (%{when})."
msgstr "Έρχεσαι στο «%{event}» (%{when})."

msgid "Event cancelled"
msgstr "Το event ακυρώθηκε"

msgid "«%{event}» (%{when}) was cancelled."
msgstr "Το «%{event}» (%{when}) ακυρώθηκε."

msgid "«%{event}» (%{when}) was cancelled: %{reason}"
msgstr "Το «%{event}» (%{when}) ακυρώθηκε: %{reason}"

msgid "Event changed"
msgstr "Το event άλλαξε"

msgid "«%{event}» moved to %{when}."
msgstr "Το «%{event}» μεταφέρθηκε στις %{when}."

msgid "«%{event}» has a new place."
msgstr "Το «%{event}» έχει νέο μέρος."

msgid "«%{event}» has a new time and place: %{when}."
msgstr "Το «%{event}» έχει νέα ώρα και μέρος: %{when}."

msgid "Starting soon"
msgstr "Ξεκινά σε λίγο"

msgid "«%{event}» starts in two hours (%{when})."
msgstr "Το «%{event}» ξεκινά σε δύο ώρες (%{when})."

msgid "Your guest is coming"
msgstr "Έρχεται ο καλεσμένος σου"

msgid "%{nickname} is coming to «%{event}» with your guest pass."
msgstr "Ο/Η %{nickname} έρχεται στο «%{event}» με την πρόσκλησή σου."

msgid "Try a class"
msgstr "Δοκίμασε ένα μάθημα"

msgid "Liked «%{event}»? %{box} invites you to a trial class."
msgstr "Σου άρεσε το «%{event}»; Το %{box} σε καλεί σε δοκιμαστικό μάθημα."

msgid "Message about «%{event}»"
msgstr "Μήνυμα για το «%{event}»"

msgid "Your invite"
msgstr "Η πρόσκλησή σου"

msgid "%{nickname} signed up with your invite."
msgstr "Ο/Η %{nickname} έκανε εγγραφή με την πρόσκλησή σου."

msgid "%{nickname} came to the event you invited them to."
msgstr "Ο/Η %{nickname} ήρθε στο event που τον/την κάλεσες."

msgid "%{nickname} came to a trial."
msgstr "Ο/Η %{nickname} ήρθε σε δοκιμαστικό."

msgid "%{nickname} subscribed."
msgstr "Ο/Η %{nickname} γράφτηκε με συνδρομή."

msgid "%{nickname} joined the box."
msgstr "Ο/Η %{nickname} έγινε μέλος του box."

msgid "Referral reward"
msgstr "Ανταμοιβή σύστασης"

msgid "Your referral reward was given."
msgstr "Η ανταμοιβή της σύστασής σου δόθηκε."

msgid "Your referral was not approved."
msgstr "Η σύστασή σου δεν εγκρίθηκε."

msgid "Your referral reward was approved."
msgstr "Η ανταμοιβή της σύστασής σου εγκρίθηκε."

msgid "Referral to approve"
msgstr "Σύσταση προς έγκριση"

msgid "%{nickname} subscribed, invited by %{referrer}."
msgstr "Ο/Η %{nickname} γράφτηκε, με πρόσκληση από %{referrer}."

msgid "New near you"
msgstr "Νέα γύρω σου"

msgid "New for «%{name}»: %{count}"
msgstr "Νέα για «%{name}»: %{count}"

msgid "Visitor at the door"
msgstr "Επισκέπτης στην πόρτα"

msgid "%{nickname} scanned the door at %{box} (%{when}) - not a member yet."
msgstr "Ο/Η %{nickname} σκάναρε την πόρτα στο %{box} (%{when}) - δεν είναι ακόμη μέλος."

msgid "%{nickname} scanned the door at %{box} (%{when}) - not a member yet. Trials are open."
msgstr "Ο/Η %{nickname} σκάναρε την πόρτα στο %{box} (%{when}) - δεν είναι ακόμη μέλος. Οι δοκιμαστικές είναι ανοιχτές."

msgid "Time for a new measurement"
msgstr "Ώρα για νέα μέτρηση"

msgid "A new snapshot helps you see your trend. It takes a minute."
msgstr "Ένα νέο στιγμιότυπο σε βοηθά να δεις την τάση σου. Παίρνει ένα λεπτό."
