DB_USER=postgres
DB_PASSWORD=postgres
DB_RUNTIME_USER=milos_runtime
DB_RUNTIME_PASSWORD=change-me-runtime-password
DB_NAME=palee_dev
DB_PORT=15434
POSTGRES_HOST_PORT=15434
REDIS_HOST_PORT=16379
MEILI_HOST_PORT=17700
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
API_HOST_PORT=18400
WEB_HOST_PORT=18300
CADDY_HTTP_HOST_PORT=18080
CADDY_HTTPS_HOST_PORT=18443
GUARDIAN_ISSUER=milos_training
# Generate with: mix phx.gen.secret
GUARDIAN_SECRET_KEY=
PHX_HOST=localhost
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
MEILI_MASTER_KEY=dev-meili-master-key

# Free-text workout assistant (Google Gemini). Server-side only; never expose
# it to the browser. Leave empty to disable AI analysis in the editor.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Reasoning effort; leave empty for models without thinking levels.
# GEMINI_THINKING_LEVEL=low
# Reasoning for the parser agent (interprets the coach text); empty for models without thinking levels.
# GEMINI_PARSER_THINKING_LEVEL=medium
# Model for AI-suggested workout library icons (ADR-136); same API key.
# GEMINI_ICON_MODEL=gemini-2.5-flash-lite
MINIO_ROOT_USER=palee_minio
MINIO_ROOT_PASSWORD=palee-minio-change-me
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://media.localhost:18080
# Browser CSP media origin list for avatar/invoice presigned uploads.
# Space- or comma-separate custom origins when needed, for example:
# NEXT_PUBLIC_MEDIA_ORIGIN=https://s3-palee.example.net
NEXT_PUBLIC_MEDIA_ORIGIN=http://media.localhost:18080
# Street maps (MapLibre style URL). Empty uses OpenFreeMap (no key). Extra
# tile/font origins the style loads from go in NEXT_PUBLIC_MAP_ORIGINS.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ORIGINS=
MINIO_BUCKET=milos-invoices
MINIO_AVATAR_BUCKET=milos-avatars
# ADR-148: private bucket for post and body photos (presigned reads only)
MINIO_MEDIA_BUCKET=milos-media
OTEL_SERVICE_NAME=palee-api
OTEL_SERVICE_NAMESPACE=palee
# Optional OTLP/HTTP trace export. Leave unset to disable network export locally.
# With the `observability` Compose profile, point it at the bundled collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Opt-in observability profile (ADR-116, ops/observability/README.md) ---
# docker compose --profile observability up -d
# Internal Prometheus listener on the API (never published, never behind Caddy).
# Prometheus scrapes api:9568, so keep 9568 when using the bundled stack.
# METRICS_PORT=9568
# Required in production when METRICS_PORT is set (>= 32 chars): openssl rand -hex 32
# METRICS_TOKEN=
# METRICS_BIND_IP=0.0.0.0
# Alert destination: any endpoint accepting Alertmanager webhook JSON
# (ntfy, Gotify, Matrix hookshot, Slack/Discord bridge, n8n, ...).
# ALERTMANAGER_WEBHOOK_URL=https://ntfy.example.com/palee-alerts
# Only for the optional email receiver (see ops/observability/alertmanager/alertmanager.yml).
# ALERTMANAGER_SMTP_PASSWORD=
# Grafana refuses to start without an admin password.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
# Host ports (bound to 127.0.0.1 only; reach them over an SSH tunnel).
# GRAFANA_HOST_PORT=13000
# PROMETHEUS_HOST_PORT=19090
# ALERTMANAGER_HOST_PORT=19093
# PROMETHEUS_RETENTION=15d
SITE_ADDRESS=http://localhost
MEDIA_SITE_ADDRESS=http://media.localhost
ACME_EMAIL=admin@example.com
DEV_ADMIN_NICKNAME=admin
DEV_ADMIN_PASSWORD=AdminPass123!
DEV_ADMIN_EMAIL=admin@example.test
# Dev seed also creates this organization with the admin as owner.
DEV_ORGANIZATION_NAME=Demo Gym
DEV_ORGANIZATION_SLUG=demo-gym

# Store apps (ADR-171). Push: Firebase service account JSON (text or path)
# for Android, the APNs .p8 key (text or path) with its key id and the Apple
# team id for iOS; APNS_TOPIC is the iOS bundle id (default app.milos.member).
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# APNS_TOPIC=app.milos.member
# Universal links / App Links (served from /.well-known by the web app).
# APPLE_TEAM_ID=
# IOS_BUNDLE_ID=app.milos.member
# ANDROID_PACKAGE_NAME=app.milos.member
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:...  (comma-separated: upload key and Play app signing key)
