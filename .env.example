DB_USER=postgres
DB_PASSWORD=postgres
DB_RUNTIME_USER=milos_runtime
DB_RUNTIME_PASSWORD=change-me-runtime-password
DB_NAME=milos_training_dev
DB_PORT=15434
POSTGRES_HOST_PORT=15434
REDIS_HOST_PORT=16379
MEILI_HOST_PORT=17700
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
API_HOST_PORT=18400
WEB_HOST_PORT=18300
CADDY_HTTP_HOST_PORT=18080
CADDY_HTTPS_HOST_PORT=18443
GUARDIAN_ISSUER=milos_training
# Generate with: mix phx.gen.secret
GUARDIAN_SECRET_KEY=
PHX_HOST=localhost
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
MEILI_MASTER_KEY=dev-meili-master-key
MINIO_ROOT_USER=milos_minio
MINIO_ROOT_PASSWORD=milos-minio-change-me
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://media.localhost:18080
# Browser CSP media origin list for avatar/invoice presigned uploads.
# Space- or comma-separate custom origins when needed, for example:
# NEXT_PUBLIC_MEDIA_ORIGIN=https://s3-milos.example.net
NEXT_PUBLIC_MEDIA_ORIGIN=http://media.localhost:18080
MINIO_BUCKET=milos-invoices
MINIO_AVATAR_BUCKET=milos-avatars
OTEL_SERVICE_NAME=milos-training-api
OTEL_SERVICE_NAMESPACE=milos-training
# Optional OTLP/HTTP trace export. Leave unset to disable network export locally.
# With the `observability` Compose profile, point it at the bundled collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Opt-in observability profile (ADR-106, ops/observability/README.md) ---
# docker compose --profile observability up -d
# Internal Prometheus listener on the API (never published, never behind Caddy).
# Prometheus scrapes api:9568, so keep 9568 when using the bundled stack.
# METRICS_PORT=9568
# Required in production when METRICS_PORT is set (>= 32 chars): openssl rand -hex 32
# METRICS_TOKEN=
# METRICS_BIND_IP=0.0.0.0
# Alert destination: any endpoint accepting Alertmanager webhook JSON
# (ntfy, Gotify, Matrix hookshot, Slack/Discord bridge, n8n, ...).
# ALERTMANAGER_WEBHOOK_URL=https://ntfy.example.com/milos-alerts
# Only for the optional email receiver (see ops/observability/alertmanager/alertmanager.yml).
# ALERTMANAGER_SMTP_PASSWORD=
# Grafana refuses to start without an admin password.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
# Host ports (bound to 127.0.0.1 only; reach them over an SSH tunnel).
# GRAFANA_HOST_PORT=13000
# PROMETHEUS_HOST_PORT=19090
# ALERTMANAGER_HOST_PORT=19093
# PROMETHEUS_RETENTION=15d
SITE_ADDRESS=http://localhost
MEDIA_SITE_ADDRESS=http://media.localhost
ACME_EMAIL=admin@example.com
DEV_ADMIN_NICKNAME=admin
DEV_ADMIN_PASSWORD=AdminPass123!
